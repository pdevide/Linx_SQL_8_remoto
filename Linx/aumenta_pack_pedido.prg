SELECT curPedidos
SCAN
	WAIT WINDOW NOWAIT "Atualizando "+TRANSFORM(RECNO("curPedidos")) + " de " + TRANSFORM(RECCOUNT("curPedidos"))
	atualiza_pedido(ALLTRIM(curPedidos.PEDIDO),curPedidos.FATOR)
	SELECT curPedidos
ENDSCAN


PROCEDURE atualiza_pedido
*========================
	PARAMETERS tcPedido, tcFator
	DIMENSION laQtde[16]

	TEXT TO cmdsql NOSHOW TEXTMERGE PRETEXT 7
	select *
	from COMPRAS_PRODUTO cp
	inner join CAEDU_COMPRAS_PRODUTOS_PACKS cpp
		ON cpp.PEDIDO = cp.PEDIDO and cpp.PRODUTO = cp.PRODUTO and cpp.COR_PRODUTO = cp.COR_PRODUTO
	WHERE cp.PEDIDO = ?tcPedido
	ENDTEXT
	F_SELECT(cmdsql, "vPedido1")
** Valida se o pedido está OK! para aumentar o Pack
* Se for cancelado, não encontrado ou já estiver recebido, então desconsiderar
	IF RECCOUNT("vPedido1")=0 OR vPedido1.QTDE_CANCELADA>0 OR vPedido1.QTDE_ENTREGUE>0
		IF RECCOUNT("vPedido1")=0
			MESSAGEBOX(tcPedido+" não encontrado!",16,"Aviso")
		ENDIF
		IF vPedido1.QTDE_CANCELADA>0
			MESSAGEBOX("Pedido "+tcPedido+" cancelado!",16,"Aviso")
		ENDIF
		IF vPedido1.QTDE_ENTREGUE>0
			MESSAGEBOX("Pedido "+tcPedido+" entregue!",16,"Aviso")
		ENDIF

		RETURN
	ENDIF

	SELECT vPedido1
	cmdUpd = "UPDATE COMPRAS_PRODUTO SET "
	cmdsql = ""
	campoCOUpd = ""
	campoCEUpd = ""
	SCAN
		laQtde = 0 && atribui 0 para todos elementos do array de qtde
		lnTot = 0
		tcProduto = vPedido1.produto
		tcCorProduto = vPedido1.cor_produto
		tcCusto = vPedido1.custo1
		FOR ixx =1 TO 16
			campo = "vPedido1.Q"+ ALLTRIM(TRANSFORM(ixx))
			IF NVL(&campo.,0)>0
				laQtde[ixx] = tcFator * &campo.
			ENDIF
			campoCOUpd = campoCOUpd + "CO"+ALLTRIM(TRANSFORM(ixx))+ " = "+TRANSFORM(laQtde[ixx])+","
			campoCEUpd = campoCEUpd + "CE"+ALLTRIM(TRANSFORM(ixx))+ " = "+TRANSFORM(laQtde[ixx])+","
			lnTot =	lnTot + laQtde[ixx]
		ENDFOR
		cmdsql = cmdUpd + campoCOUpd + campoCEUpd
		cmdsql = cmdsql + " QTDE_ORIGINAL = " + TRANSFORM(lnTot)+ ", QTDE_ENTREGAR = " + TRANSFORM(lnTot)
		cmdsql = cmdsql + " ,VALOR_ORIGINAL = " + STRTRAN(TRANSFORM(lnTot * tcCusto, "999999.99"),",",".")+ ", VALOR_ENTREGAR = " + STRTRAN(TRANSFORM(lnTot * tcCusto, "999999.99"),",",".")
		cmdsql = cmdsql + " WHERE PEDIDO = ?tcPedido AND PRODUTO = ?tcProduto and COR_PRODUTO = ?tcCorProduto "
*MESSAGEBOX(cmdsql)
** atualiza compras_produto
		F_EXECUTE(cmdsql)
	ENDSCAN
	TEXT TO cmdsql NOSHOW TEXTMERGE PRETEXT 7
	select PEDIDO, sum(QTDE_ORIGINAL) as QTDE_ORIGINAL, sum(QTDE_ENTREGAR) as QTDE_ENTREGAR,
				sum(VALOR_ORIGINAL) as VALOR_ORIGINAL, sum(VALOR_ENTREGAR) as VALOR_ENTREGAR
	from compras_produto cp
	WHERE cp.PEDIDO = ?tcPedido
	group by PEDIDO
	ENDTEXT
	F_SELECT(cmdsql,"vPedido2")
	TEXT TO cmdsql NOSHOW TEXTMERGE
	UPDATE COMPRAS
	SET TOT_QTDE_ORIGINAL = ?vPedido2.QTDE_ORIGINAL,
		TOT_VALOR_ORIGINAL = ?vPedido2.VALOR_ORIGINAL,
		TOT_QTDE_ENTREGAR = ?vPedido2.QTDE_ENTREGAR,
		TOT_VALOR_ENTREGAR = ?vPedido2.VALOR_ENTREGAR,
		ERP_CAB_QTDPECAS = ?vPedido2.QTDE_ORIGINAL,
		ERP_TOTAL_QTD_DISTRIB = ?tcFator,
		ERP_TOTAL_CAIXAS_ORIGINAL = ?tcFator
	WHERE PEDIDO = ?tcPedido
	ENDTEXT
** atualiza_compras
	F_EXECUTE(cmdsql)

*MESSAGEBOX(cmdsql)

ENDPROC

