										</xsd:restriction>
									</xsd:simpleType>
								</xsd:element>
								<xsd:element name="inativo" type="xsd:boolean"/>
							</xsd:sequence>
						</xsd:complexType>
					</xsd:element>
				</xsd:choice>
				<xsd:anyAttribute namespace="http://www.w3.org/XML/1998/namespace" processContents="lax"/>
			</xsd:complexType>
