SCHEMA BANCO DE DADOS	: dbo

OBJETO COM PROBLEMA	: LX_CTB_LEITURA_LAYOUTS

DESCRIÇÃO DO PROBLEMA	: LX_CTB_LEITURA_LAYOUTS -- Incorrect syntax near '30002'.

CONTEÚDO DO OBJETO		: 

CREATE PROCEDURE   [dbo].[LX_CTB_LEITURA_LAYOUTS]     @LAYOUT_FILTER    VARCHAR(4)        =      NULL,
                                                                 @MOVE_FILE        BIT                     =     1,
                                                                 @ID_LAYOUT        INT                     =     NULL,
                                                                 @FILENAME_TEMP      VARCHAR(1000)     =     NULL

--10/04 LUCIANO        
-- 22/01/2013 - LUCAS SOUZA        - TP 3256445 - #3# - CASO O ARQUIVO LIDO SEJA INVÁLIDO, O IGNORA E CONTINUA IMPORTAÇÃO                                                            
-- 10/10/2012 - ALEX BORTOTO     - TP 3047259 - #2# - ALTERADO PARA EFETUAR UM REPLACE DO CARACTERE ' AO GERAR A LINHA DO ARQUIVO
-- 12/06/2012 - DANIEL GONCALVES - TP 2509827 - #1# - ALTERADO A VALIDAÇÃO DOS LAYOUTS, QUANDO A MENSAGEM DE ERRO ESTAVA VAZIA ELE FAZIA O PROCESSO, POREM COM 2 ITENS UM COM ERRO E UM CORRETO, ELE LIA O ARQUIVO GRAVAVA NA TABELA MAIS NAO MOVIA PARA A PASTA LIDOS.
-- 29/03/2012 - ALEX BORTOTO - TP 2384970 - INCLUIDO PARA NÃO VERIFICAR O LAYOUT COM O TIPO DE CONCILIAÇÃO 7                                                            
-- 22/07/2011 - JOAO RICARDO - VOLTAR O IDENTIFICADOR REGISTRO 
-- 12/07/2011 - ADRIANO RODRIGUES - PREENCHER VALOR NO CAMPO [IDENTIFICADOR REGISTRO]
-- 29/03/2010 - ADRIANO RODRIGUES - INCLUIR NO FINAL DA PROCEDURE O CÓDIGO PARA GERAR O XML DO ARQUIVO (COMENTADO NA PROCEDURE PORQUE O PROJETO ESTA PARADO)
-- 19/01/2010 - ADRIANO RODRIGUES - ACERTO PARA TRANSAÇÕES DEPENDENTES COM MAIS DE UMA LINHA NÃO DUPLICAR VALORES
-- 15/01/2010 - ADRIANO RODRIGUES - PERMITIR LER LAYOUTS COM O CAMPO ID_LAYOUT NULO
-- 06/01/2010 - ADRIANO RODRIGUES - PERMITIR QUE A LEITURA DO LAYOUT ENTENDA TRANSAÇÕES DEPENDENTES DE OUTRA
-- 18/11/2009 - ADRIANO RODRIGUES - ALTERAR A MASCARA DE ACORDO COM O TAMANHO DO CAMPO NO LAYOUT
-- 08/10/2009 - JOAO RICARDO - RETORNO DE SELECT NO FINAL DA PROCEDURE
-- 21/08/2009 - JOAO RICARDO - AUMENTAR A VARIAVEL DE LEITURA
-- 07/08/2008 - ALESSANDRO - ADIÇÃO DO TRATAMENTO PARA O CAMPO IDENTIFICADOR MOVIMENTO
-- 07/08/2008 - ALESSANDRO - AJUSTE DO MECANISMO DE FETCH DO CURSOR DOS LAYOUTS
-- 04/08/2008 - ALESSANDRO - MELHORAR MENSAGEM DE CRÍTICA QUANDO HÁ PROBLEMAS ENTRE O LAYOUT E O ARQUIVO
-- 24/07/2008 - ALESSANDRO - MOVER OS ARQUIVOS APENAS NO FIM DO PROCESSO E COM @MOVE_FILE = 1
-- 20/05/2008 - ALESSANDRO - CRIADA PARA LEITURA DOS LAYOUTS COM CONCILIAÇÃO AUTOMÁTICA
AS
BEGIN
      SET NOCOUNT ON

      --GENERATE LAYOUT SEQUENCE
      IF NOT EXISTS     (     SELECT 1 FROM SEQUENCIAIS WHERE TABELA_COLUNA = 'CTB_ARQ_CONCILIACAO.ID_ARQUIVO'   )
            INSERT INTO SEQUENCIAIS (     TABELA_COLUNA,  DESCRICAO,  SEQUENCIA, TAMANHO )
                                   VALUES      (     'CTB_ARQ_CONCILIACAO.ID_ARQUIVO', 'CONCILIAÇÃO AUTOMÁTICA DE BORDERÔS', '00000000000000', 14 )

      --DECLARE VARIABLES
      DECLARE     @LAYOUT                            CHAR(4),
                  @DATE_MASK                   VARCHAR(10),
                  @F_NAME                            VARCHAR(255),
                  @ROW_CONTENT                 VARCHAR(1000),
                  @COD_TRAN_LAYOUT        CHAR(5),
                  @INSERT_FIELDS               VARCHAR(8000),
                  @INSERT_SCRIPT               VARCHAR(8000),
                  @INSERT_FIELDS_DEP           VARCHAR(8000),
                  @INSERT_SCRIPT_DEP           VARCHAR(8000),
                  @TOPOLOGIA_DEP               CHAR(5),
                  @INSERT_FIELDS_CAB           VARCHAR(8000),
                  @INSERT_SCRIPT_CAB           VARCHAR(8000),
                  @MSG_ERROR                   VARCHAR(8000),
                  @SEQUENCE_LAYOUT_FILE   INT,
                  @RECORD_NAME                 VARCHAR(40),
                  @DIRETORIO_ARQUIVO           VARCHAR(100),
                  @FULL_FILE_PATH              VARCHAR(255),
                  @FULL_MOVE_PATH              VARCHAR(255),
                  @TIPO_CONCILIACAO       INT

      DECLARE     @ID_ROW_T               VARCHAR(50),
                  @POS_ID_ROW_T           SMALLINT,
                  @LEN_ID_ROW_T           SMALLINT,
                  @ID_ROW_D               VARCHAR(50),
                  @POS_ID_ROW_D           SMALLINT,
                  @LEN_ID_ROW_D           SMALLINT,
                  @ID_ROW_C               VARCHAR(50),
                  @POS_ID_ROW_C           SMALLINT,
                  @LEN_ID_ROW_C           SMALLINT,
                  @VALID_LAYOUT           VARCHAR(255),
                  @POS_VALID_LAYOUT SMALLINT,
                  @LEN_VALID_LAYOUT SMALLINT,
                  @DELIMITER              CHAR(1),
                  @EXTERNAL_PROCEDURE     VARCHAR(100),
                  @SCRIPT_TO_EXEC         VARCHAR(1000),
                  @ID_ROW_DIFF            VARCHAR(10),
                  @POS_ID_ROW_DIFF  SMALLINT,
                  @LEN_ID_ROW_DIFF  SMALLINT,
                  @ID_ROW_DIFF_C          VARCHAR(10),
                  @POS_ID_ROW_DIFF_C      SMALLINT,
                  @LEN_ID_ROW_DIFF_C      SMALLINT,
                  @ID_ROW_MOV             VARCHAR(10),
                  @POS_ID_ROW_MOV         SMALLINT,
                  @LEN_ID_ROW_MOV         SMALLINT,
                  @VALUE_MOV              VARCHAR(250)

      --DECLARE TABLES  
      DECLARE     @FILES_TO_MOVE    TABLE (     DIRECTORY         VARCHAR(100)      COLLATE      DATABASE_DEFAULT,
                                                           FULL_FILE_PATH    VARCHAR(255)      COLLATE     DATABASE_DEFAULT,
                                                           FULL_MOVE_PATH    VARCHAR(255)      COLLATE     DATABASE_DEFAULT  )

      DECLARE     @DIFFS_LAYOUT     TABLE (     COD_DIFF          CHAR(5)                 COLLATE     DATABASE_DEFAULT,
                                                           ID_ROW_DIFF       VARCHAR(250)      COLLATE     DATABASE_DEFAULT,
                                                           POS_ID_ROW_DIFF   INT,
                                                           LEN_ID_ROW_DIFF   INT   )

      DECLARE     @LAYOUT_FIELDS    TABLE (     DATAFIELD         VARCHAR(100)      COLLATE      DATABASE_DEFAULT,
                                                           TOPOLOGY          CHAR(5)                 COLLATE     DATABASE_DEFAULT,
                                                           POSITION          SMALLINT,
                                                           DATATYPE          CHAR(1)                 COLLATE     DATABASE_DEFAULT,
                                                           DATALEN                 TINYINT,
                                                           DECIMALS          TINYINT,
                                                           FIXED_VALUES      VARCHAR(250)      COLLATE     DATABASE_DEFAULT  )

      CREATE TABLE      #FILES_READED     (     F_NAME                  VARCHAR(255)      COLLATE     DATABASE_DEFAULT,
                                                           ROW_CONTENT       VARCHAR(1000)      COLLATE     DATABASE_DEFAULT,
                                                           INDEX_ID          INT   IDENTITY      )

      SELECT      @MSG_ERROR  =     ''

      

      --GET LAYOUTS TO PROCESS  
      DECLARE     CUR_LAYOUTS CURSOR READ_ONLY FAST_FORWARD LOCAL FOR
            SELECT      LAYOUT, MASCARA_DATA, DELIMITADOR, DIRETORIO_ARQUIVO, TIPO_CONCILIACAO  
            FROM  CTB_BORDERO_LAYOUT
            WHERE TIPO_CONCILIACAO  >     0     AND TIPO_CONCILIACAO <> 7 AND
                        INATIVO                      =     0                            AND
                        (     @LAYOUT_FILTER    IS    NULL  OR
                             LAYOUT                  =     @LAYOUT_FILTER    )     AND
                             --ID_LAYOUT             IS    NOT   NULL              AND
                        (     ID_LAYOUT         =     @ID_LAYOUT  OR
                             @ID_LAYOUT        IS    NULL  )
            ORDER BY    TIPO_CONCILIACAO, LX_TIPO_BORDERO, LAYOUT

      OPEN  CUR_LAYOUTS
      FETCH NEXT FROM   CUR_LAYOUTS INTO  @LAYOUT, @DATE_MASK, @DELIMITER, @DIRETORIO_ARQUIVO, @TIPO_CONCILIACAO
      --LOOP LAYOUTS
      WHILE @@FETCH_STATUS    =     0
      BEGIN
      
            --MOVE FILE TO    
            SELECT      @FULL_MOVE_PATH   =     RTRIM(@DIRETORIO_ARQUIVO)    +     CASE WHEN RIGHT(RTRIM(@DIRETORIO_ARQUIVO), 1) = '\' THEN '' ELSE '\' END   +     'READED\'

            --IDENTIFICADOR DO MOVIMENTO
            SELECT      @ID_ROW_MOV = '', @POS_ID_ROW_MOV = 0, @LEN_ID_ROW_MOV = 0, @VALUE_MOV = ''
            
            SELECT      @ID_ROW_MOV = RTRIM(A.PARAMETROS), @POS_ID_ROW_MOV = A.POSICAO, @LEN_ID_ROW_MOV = A.TAMANHO
            FROM  CTB_BORDERO_LAYOUT_CAMPO AS A
                        INNER JOIN  CTB_BORDERO_LAYOUT_CMD AS B  ON    (     A.ID_COMANDO      =     B.ID_COMANDO      )
            WHERE A.LAYOUT          =     @LAYOUT     AND
                        A.LX_TOPOLOGIA    =     'C'         AND
                        B.DESC_COMANDO    =     'IDENTIFICADOR MOVIMENTO'

            --GET EXTERNAL PROCEDURE
            SELECT      @EXTERNAL_PROCEDURE = ''
            
            SELECT      @EXTERNAL_PROCEDURE     =     A.PARAMETROS
            FROM  CTB_BORDERO_LAYOUT_CAMPO AS A
                        INNER JOIN  CTB_BORDERO_LAYOUT_CMD AS B  ON    (A.ID_COMANDO     =      B.ID_COMANDO)
            WHERE A.LAYOUT          =     @LAYOUT                      AND
                        B.DESC_COMANDO    =     'PROCEDURE EXTERNA'     AND
                        A.LX_TOPOLOGIA    =     'C'

            IF    @EXTERNAL_PROCEDURE     =     ''    OR
                  NOT EXISTS  (     SELECT      1     FROM  SYSOBJECTS  WHERE NAME  =      @EXTERNAL_PROCEDURE     AND   XTYPE =     'P'   )
            BEGIN
                  SELECT      @MSG_ERROR  =     @MSG_ERROR  + CHAR(13) + CHAR(10)   +     'O layout [' + @LAYOUT + '] está com o campo [PROCEDURE EXTERNA] incorreto.'
                  FETCH NEXT FROM   CUR_LAYOUTS INTO  @LAYOUT , @DATE_MASK, @DELIMITER, @DIRETORIO_ARQUIVO, @TIPO_CONCILIACAO
                  CONTINUE
            END
            

            --GENERATE DIFFS
            DELETE      FROM  @DIFFS_LAYOUT
            
            INSERT INTO @DIFFS_LAYOUT     (     COD_DIFF, ID_ROW_DIFF, POS_ID_ROW_DIFF, LEN_ID_ROW_DIFF   )
                  SELECT      A.LX_TOPOLOGIA, A.PARAMETROS, A.POSICAO, A.TAMANHO
                  FROM  CTB_BORDERO_LAYOUT_CAMPO AS A
                             INNER JOIN  CTB_BORDERO_LAYOUT_CMD AS B  ON    (A.ID_COMANDO      =     B.ID_COMANDO)
                  WHERE A.LAYOUT          =     @LAYOUT     AND
                             B.DESC_COMANDO    =     'DIFERENCIADOR REGISTRO'

            --VERIFY IF IN HEADER EXISTS THE FIELD [IDENTIFICADOR REGISTRO] OR [IDENTIFICADOR REGISTRO VALIDAR]
            SELECT      @ID_ROW_C = '', @POS_ID_ROW_C = 0, @LEN_ID_ROW_C = 0

            SELECT      @ID_ROW_C = RTRIM(A.PARAMETROS), @POS_ID_ROW_C = A.POSICAO, @LEN_ID_ROW_C = A.TAMANHO
            FROM  CTB_BORDERO_LAYOUT_CAMPO AS A
                        INNER JOIN  CTB_BORDERO_LAYOUT_CMD AS B  ON    (A.ID_COMANDO     =      B.ID_COMANDO)
            WHERE A.LAYOUT          =     @LAYOUT     AND
                        A.LX_TOPOLOGIA    =     'C'         AND
                        B.DESC_COMANDO    =     'IDENTIFICADOR REGISTRO'

            IF    @ID_ROW_C   =     ''
            BEGIN
                  SELECT      @ID_ROW_C = '', @POS_ID_ROW_C = 0, @LEN_ID_ROW_C = 0

                  SELECT      @ID_ROW_C         =     @ID_ROW_C   +     CASE WHEN @ID_ROW_C = '' THEN '' ELSE ',' END +     RTRIM(C.VALOR_CAMPO),
                             @POS_ID_ROW_C     =     A.POSICAO,
                             @LEN_ID_ROW_C     =     A.TAMANHO
                  FROM  CTB_BORDERO_LAYOUT_CAMPO AS A
                             INNER JOIN  CTB_BORDERO_LAYOUT_CMD AS B        ON    (      A.ID_COMANDO      =     B.ID_COMANDO      )
                             INNER JOIN  CTB_BORDERO_LAYOUT_VALIDA AS C     ON    (      A.LAYOUT          =     C.LAYOUT    AND
                                                                                                          A.POSICAO         =     C.POSICAO   AND
                                                                                                          A.LX_TOPOLOGIA    =     C.LX_TOPOLOGIA    )
                  WHERE A.LAYOUT          =     @LAYOUT     AND
                             A.LX_TOPOLOGIA    =     'C'         AND
                             B.DESC_COMANDO    =     'IDENTIFICADOR REGISTRO VALIDAR'
            END    

            IF    @ID_ROW_C   <>    ''
                  SET   @ID_ROW_C   =     ','   +     RTRIM(@ID_ROW_C)  +     ','
            ELSE
                  SET   @ID_ROW_C   =     '*'   --ALWAYS READ HEADER

            SELECT      @ID_ROW_DIFF_C    =     ''
            
            IF    EXISTS      (     SELECT      1     FROM  @DIFFS_LAYOUT     WHERE COD_DIFF      =     'C'   )
            BEGIN
                  SELECT      @ID_ROW_DIFF_C = ID_ROW_DIFF, @POS_ID_ROW_DIFF_C = POS_ID_ROW_DIFF, @LEN_ID_ROW_DIFF_C = LEN_ID_ROW_DIFF
                  FROM  @DIFFS_LAYOUT
                  WHERE COD_DIFF    =     'C'
            END

            -------------------------------------------------------------------------------------------------------------------------------------------------------
            --CREATE TABLE WITH ALL FIELDS OF LAYOUT
            DELETE FROM @LAYOUT_FIELDS
            
            INSERT INTO @LAYOUT_FIELDS
                  SELECT      DISTINCT
                             '['   +     RTRIM(B.DESC_COMANDO)   +     ']' AS DATAFIELD,
                             A.LX_TOPOLOGIA,
                             A.POSICAO AS POSITION,
                              B.LX_TIPO_DADO AS DATATYPE,
                             A.TAMANHO AS DATALEN,
                             A.DECIMAIS AS DECIMALS,
                             A.PARAMETROS AS FIXED_VALUES
                  FROM  CTB_BORDERO_LAYOUT_CAMPO AS A   
                             INNER JOIN  CTB_BORDERO_LAYOUT_CMD AS B  ON    (      A.ID_COMANDO      =     B.ID_COMANDO      )
                  WHERE A.LAYOUT          =           @LAYOUT     AND
                             B.DESC_COMANDO    NOT IN      (     'VALIDACAO DO LAYOUT', 'IDENTIFICADOR REGISTRO', 'PROCEDURE EXTERNA', 'IDENTIFICADOR REGISTRO VALIDAR', 
                                                                       'DIFERENCIADOR REGISTRO', 'IDENTIFICADOR MOVIMENTO'     )
                  ORDER BY    1

            BEGIN TRY  
                  --CREATE LAYOUT STRUCTURE 
                  
                  EXEC  LX_CTB_CREATE_LAYOUT_STRUCTURE     @LAYOUT
                  
                  /*#3#*/
                  IF (SELECT OBJECT_ID('TEMPDB..#LAYOUT_CONTENT')) IS NOT NULL
                        DROP TABLE #LAYOUT_CONTENT

                  SELECT      *
                  INTO  #LAYOUT_CONTENT
                  FROM  ##LAYOUT_CONTENT

                  EXEC  LX_CTB_RELEASE_LAYOUT_STRUCTURE

                  --READ FILES CONTENT  
                  
                  EXEC  LX_CTB_LEITURA_ARQUIVOS_LAYOUT     @LAYOUT, '#FILES_READED', @FILENAME_TEMP
                  
            END TRY  
            BEGIN CATCH  
                  SELECT      @MSG_ERROR  =     @MSG_ERROR  +     CHAR(13) + CHAR(10) + 'Error: ' + CONVERT(VARCHAR(20), ISNULL(ERROR_NUMBER(), 0)) + ' Message: ' + ISNULL(RTRIM(ERROR_MESSAGE()), '') + ' Proc: ' + ISNULL(RTRIM(ERROR_PROCEDURE()), '')
                  SELECT      @MSG_ERROR  =     @MSG_ERROR  +     ' LayOut: ' +      RTRIM(@LAYOUT)
                  /*#3#*/
                  /*GOTO      ENDPROC*/
                  FETCH NEXT FROM   CUR_LAYOUTS INTO  @LAYOUT , @DATE_MASK, @DELIMITER, @DIRETORIO_ARQUIVO, @TIPO_CONCILIACAO
                  CONTINUE
            END CATCH

            --VALID LAYOUT
            SELECT      @VALID_LAYOUT = '', @POS_VALID_LAYOUT = 0, @LEN_VALID_LAYOUT = 0
            
            SELECT      @VALID_LAYOUT = A.PARAMETROS, @POS_VALID_LAYOUT = A.POSICAO, @LEN_VALID_LAYOUT = A.TAMANHO
            FROM  CTB_BORDERO_LAYOUT_CAMPO AS A
                        INNER JOIN  CTB_BORDERO_LAYOUT_CMD AS B  ON    (     A.ID_COMANDO      =     B.ID_COMANDO      )
            WHERE A.LAYOUT = @LAYOUT AND A.LX_TOPOLOGIA = 'C' AND B.DESC_COMANDO = 'VALIDACAO DO LAYOUT'
            --END VALID LAYOUT
            
            DECLARE     CUR_FILES_LAYOUT  CURSOR READ_ONLY FAST_FORWARD LOCAL FOR
                  SELECT      DISTINCT
                             F_NAME
                  FROM  #FILES_READED

            OPEN  CUR_FILES_LAYOUT
            FETCH NEXT FROM   CUR_FILES_LAYOUT  INTO  @F_NAME
            WHILE @@FETCH_STATUS    =     0
            BEGIN
            
                  --FULL FILE PATH
                  SET   @FULL_FILE_PATH   =     RTRIM(@DIRETORIO_ARQUIVO) + CASE WHEN RIGHT(RTRIM(@DIRETORIO_ARQUIVO),1)='\' THEN '' ELSE '\' END + @F_NAME

                  --VALID LAYOUT
                  IF    @VALID_LAYOUT     <>    ''
                  BEGIN
                  
                        SELECT      TOP 1
                                   @ROW_CONTENT      =     ROW_CONTENT
                        FROM  #FILES_READED
                        WHERE F_NAME      =     @F_NAME
                        ORDER BY    INDEX_ID

                        IF    ('''' + RTRIM(@VALID_LAYOUT) + '''')     <>      DBO.FX_CTB_GET_FIELD_CONTENT(@ROW_CONTENT, 'C', @POS_VALID_LAYOUT, @LEN_VALID_LAYOUT, 0, '', '', @DELIMITER)
                        BEGIN  
                             SET   @MSG_ERROR  =     @MSG_ERROR + CHAR(13) + CHAR(10) + 'LayOut: '+rtrim(@LAYOUT) + ' O arquivo ['+@F_NAME+'] não passou pelo campo [VALIDACAO DO LAYOUT].'

                             FETCH NEXT FROM   CUR_FILES_LAYOUT  INTO  @F_NAME
                             CONTINUE
                        END
                  END

                  --GET TRANSACTIONS TO READ
                  DECLARE     CUR_TRANSACTIONS_LAYOUT CURSOR READ_ONLY FAST_FORWARD LOCAL FOR
                        SELECT      A.LX_TOPOLOGIA, A.PARAMETROS, A.POSICAO, A.TAMANHO, B.DESC_COMANDO
                        FROM  CTB_BORDERO_LAYOUT_CAMPO AS A
                                   INNER JOIN  CTB_BORDERO_LAYOUT_CMD AS B  ON    (      A.ID_COMANDO      =     B.ID_COMANDO      )
                        WHERE A.LAYOUT          =           @LAYOUT                                                                                 AND
                                   A.LX_TOPOLOGIA    LIKE  'T%'                                                                              AND
                                   A.LX_TOPOLOGIA    NOT IN      (     SELECT      A.LX_TOPOLOGIA
                                                                            FROM      CTB_BORDERO_LAYOUT_CAMPO AS A
                                                                                        INNER JOIN  CTB_BORDERO_LAYOUT_CMD AS B  ON    (     A.ID_COMANDO      =     B.ID_COMANDO      )
                                                                            WHERE A.LAYOUT            =     @LAYOUT                      AND
                                                                                        B.DESC_COMANDO    =     'TRANSACAO DEPENDENTE'  )     AND
                                   B.DESC_COMANDO    IN    (     'IDENTIFICADOR REGISTRO', 'IDENTIFICADOR REGISTRO VALIDAR'   )
                        ORDER BY    1

                  OPEN  CUR_TRANSACTIONS_LAYOUT
                  FETCH NEXT FROM   CUR_TRANSACTIONS_LAYOUT INTO  @COD_TRAN_LAYOUT, @ID_ROW_T, @POS_ID_ROW_T, @LEN_ID_ROW_T, @RECORD_NAME
                  WHILE @@FETCH_STATUS    =     0
                  BEGIN
                  
                        IF    @ID_ROW_T   <>    '*'
                        BEGIN
                             IF    @RECORD_NAME      =     'IDENTIFICADOR REGISTRO VALIDAR'
                             BEGIN
                                   SET   @ID_ROW_T   =     ''

                                   SELECT      @ID_ROW_T   =     @ID_ROW_T   +     CASE WHEN @ID_ROW_T = '' THEN '' ELSE ',' END + RTRIM(C.VALOR_CAMPO)
                                   FROM  CTB_BORDERO_LAYOUT_CAMPO AS A
                                               INNER JOIN  CTB_BORDERO_LAYOUT_CMD AS B        ON    (     A.ID_COMANDO      =     B.ID_COMANDO      )
                                               INNER JOIN  CTB_BORDERO_LAYOUT_VALIDA AS C      ON    (     A.LAYOUT          =     C.LAYOUT    AND
                                                                                                                           A.POSICAO         =     C.POSICAO   AND
                                                                                                                           A.LX_TOPOLOGIA    =     C.LX_TOPOLOGIA    )
                                   WHERE A.LAYOUT          =     @LAYOUT                       AND
                                               A.LX_TOPOLOGIA    =     @COD_TRAN_LAYOUT  AND
                                               B.DESC_COMANDO    =     'IDENTIFICADOR REGISTRO VALIDAR'
                             END

                             SET   @ID_ROW_T   =     ',' + RTRIM(@ID_ROW_T) + ','
                        END

                        SELECT      @ID_ROW_DIFF      =     ''

                        IF    EXISTS      (     SELECT      1     FROM  @DIFFS_LAYOUT     WHERE      COD_DIFF    =     @COD_TRAN_LAYOUT  )
                        BEGIN
                             SELECT      @ID_ROW_DIFF = ID_ROW_DIFF, @POS_ID_ROW_DIFF = POS_ID_ROW_DIFF, @LEN_ID_ROW_DIFF = LEN_ID_ROW_DIFF
                             FROM  @DIFFS_LAYOUT
                             WHERE COD_DIFF    =     @COD_TRAN_LAYOUT
                        END

                        --Transações dependentes
                        SELECT      @ID_ROW_D = '', @POS_ID_ROW_D = 0, @LEN_ID_ROW_D = 0
                        
                        SELECT      @TOPOLOGIA_DEP    =     MIN(A.TOPOLOGY)
                        FROM  @LAYOUT_FIELDS AS A
                        WHERE LEFT(A.TOPOLOGY, 1)     =     'T'                                      AND
                                   A.DATAFIELD             =     '[TRANSACAO DEPENDENTE]'      AND
                                   A.FIXED_VALUES          =     @COD_TRAN_LAYOUT

                        IF    (     @TOPOLOGIA_DEP    IS NOT      NULL  )
                        BEGIN 
                             SELECT      @ID_ROW_D = RTRIM(A.PARAMETROS), @POS_ID_ROW_D = A.POSICAO, @LEN_ID_ROW_D = A.TAMANHO
                             FROM  CTB_BORDERO_LAYOUT_CAMPO AS A
                                         INNER JOIN  CTB_BORDERO_LAYOUT_CMD AS B  ON    (      A.ID_COMANDO      =     B.ID_COMANDO      )
                             WHERE A.LAYOUT          =     @LAYOUT                 AND
                                         A.LX_TOPOLOGIA    =     @TOPOLOGIA_DEP    AND
                                         B.DESC_COMANDO    =     'IDENTIFICADOR REGISTRO'

                             IF    @ID_ROW_D   <>    ''
                                   SET   @ID_ROW_D   =     ',' + RTRIM(@ID_ROW_D) + ','
                             ELSE
                                   SET   @ID_ROW_D   =     '*'   --ALWAYS READ HEADER
                        END

                        DECLARE     CUR_ROWS_LAYOUT   CURSOR READ_ONLY FAST_FORWARD LOCAL FOR
                             SELECT      REPLACE(ROW_CONTENT,'''','') --#2#
                             FROM  #FILES_READED
                             WHERE F_NAME      =     @F_NAME
                             ORDER BY    INDEX_ID

                        OPEN  CUR_ROWS_LAYOUT
                        FETCH NEXT FROM   CUR_ROWS_LAYOUT   INTO  @ROW_CONTENT
                        --LOOP FILES FROM LAYOUT  
                        WHILE @@FETCH_STATUS    =     0
                        BEGIN
                        
                             -----------------------------------------------------------------------------------------------------------------------------------------
                             IF    ISNULL(@ID_ROW_MOV,'')  <>    ''    AND
                                   @ID_ROW_MOV                  =      DBO.FX_CTB_GET_FIELD_CONTENT(@ROW_CONTENT, 'I', @POS_ID_ROW_C, @LEN_ID_ROW_C, 0, '', '', @DELIMITER)
                             BEGIN  
                                   SELECT      @VALUE_MOV  =      DBO.FX_CTB_GET_FIELD_CONTENT(@ROW_CONTENT, 'C', @POS_ID_ROW_MOV, @LEN_ID_ROW_MOV, 0, '', '', @DELIMITER)
                             END

                             --Cabeçalho
                             IF    @ID_ROW_C   =     '*'   OR
                                   CHARINDEX(','+DBO.FX_CTB_GET_FIELD_CONTENT(@ROW_CONTENT, 'I', @POS_ID_ROW_C, @LEN_ID_ROW_C, 0, '', '', @DELIMITER)+',', @ID_ROW_C) > 0
                             BEGIN  
                                   IF    ISNULL(@ID_ROW_DIFF_C, '')   =     ''          OR
                                         @ID_ROW_DIFF_C                     =      DBO.FX_CTB_GET_FIELD_CONTENT(@ROW_CONTENT, 'I', @POS_ID_ROW_DIFF_C, @LEN_ID_ROW_DIFF_C, 0, '', '', @DELIMITER)
                                   BEGIN
                                         IF    ISNULL(@ID_ROW_MOV, '') <>    ''
                                               SELECT      @INSERT_FIELDS_CAB      =      '[IDENTIFICADOR MOVIMENTO]', @INSERT_SCRIPT_CAB      =     ISNULL(@VALUE_MOV, '')
                                         ELSE
                                               SELECT      @INSERT_FIELDS_CAB      =     '', @INSERT_SCRIPT_CAB      =     ''

                                         SELECT      @INSERT_FIELDS_CAB      =      @INSERT_FIELDS_CAB + CASE WHEN @INSERT_FIELDS_CAB = '' THEN '' ELSE ',' END + A.DATAFIELD,
                                                     @INSERT_SCRIPT_CAB      =      @INSERT_SCRIPT_CAB + CASE WHEN @INSERT_SCRIPT_CAB = '' THEN '' ELSE ',' END +
                                                     DBO.FX_CTB_GET_FIELD_CONTENT(@ROW_CONTENT, A.DATATYPE, A.POSITION, A.DATALEN, A.DECIMALS, A.FIXED_VALUES,
                                                     CASE  WHEN  A.DATALEN   =     6     AND      LEN(@DATE_MASK)   =     8     AND   LEFT(@DATE_MASK, 1)     =     'A'   THEN      RIGHT(@DATE_MASK, 6)
                                                                 WHEN  A.DATALEN   =     6      AND   LEN(@DATE_MASK)   =     8     AND   LEFT(@DATE_MASK, 1)     <>    'A'   THEN      LEFT(@DATE_MASK, 6)
                                                                 WHEN  A.DATALEN   =     8      AND   LEN(@DATE_MASK)   =     6     AND   LEFT(@DATE_MASK, 1)     =     'A'   THEN  'AA' + @DATE_MASK
                                                                 WHEN  A.DATALEN   =     8      AND   LEN(@DATE_MASK)   =     6     AND   LEFT(@DATE_MASK, 1)     <>    'A'   THEN      @DATE_MASK + 'AA'
                                                                 ELSE  @DATE_MASK  END, @DELIMITER)
                                         FROM  @LAYOUT_FIELDS AS A
                                         WHERE A.TOPOLOGY  =     'C'
                                   END  
                             END  

                             --Transações dependentes                             
                              IF    (     @TOPOLOGIA_DEP    IS NOT      NULL  )
                             BEGIN
                                   IF    CHARINDEX(',' + DBO.FX_CTB_GET_FIELD_CONTENT(@ROW_CONTENT, 'I', @POS_ID_ROW_D, @LEN_ID_ROW_D, 0, '', '', @DELIMITER)+',', @ID_ROW_D) > 0
                                   BEGIN
                                         IF    ISNULL(@ID_ROW_MOV, '') <>    ''
                                               SELECT      @INSERT_FIELDS_DEP      =      '[IDENTIFICADOR MOVIMENTO]', @INSERT_SCRIPT_DEP      =     ISNULL(@VALUE_MOV, '')
                                         ELSE
                                               SELECT      @INSERT_FIELDS_DEP      =     '', @INSERT_SCRIPT_DEP      =     ''

                                         SELECT      @INSERT_FIELDS_DEP      =      @INSERT_FIELDS_DEP + CASE WHEN @INSERT_FIELDS_DEP = '' THEN '' ELSE ',' END + A.DATAFIELD,
                                                     @INSERT_SCRIPT_DEP      =      @INSERT_SCRIPT_DEP + CASE WHEN @INSERT_SCRIPT_DEP = '' THEN '' ELSE ',' END +
                                                     DBO.FX_CTB_GET_FIELD_CONTENT(@ROW_CONTENT, A.DATATYPE, A.POSITION, A.DATALEN, A.DECIMALS, A.FIXED_VALUES,
                                                     CASE  WHEN  A.DATALEN   =     6     AND      LEN(@DATE_MASK)   =     8     AND   LEFT(@DATE_MASK, 1)     =     'A'   THEN      RIGHT(@DATE_MASK, 6)
                                                                 WHEN  A.DATALEN   =     6      AND   LEN(@DATE_MASK)   =     8     AND   LEFT(@DATE_MASK, 1)     <>    'A'   THEN      LEFT(@DATE_MASK, 6)
                                                                 WHEN  A.DATALEN   =     8      AND   LEN(@DATE_MASK)   =     6     AND   LEFT(@DATE_MASK, 1)     =     'A'   THEN  'AA' + @DATE_MASK
                                                                 WHEN  A.DATALEN   =     8      AND   LEN(@DATE_MASK)   =     6     AND   LEFT(@DATE_MASK, 1)     <>    'A'   THEN      @DATE_MASK + 'AA'
                                                                 ELSE  @DATE_MASK  END, @DELIMITER)
                                         FROM  @LAYOUT_FIELDS AS A
                                         WHERE A.TOPOLOGY  =     @TOPOLOGIA_DEP    AND
                                                     A.DATAFIELD <>    '[TRANSACAO DEPENDENTE]'
                                   END  
                             END

                             --Transações
                             IF    (     @ID_ROW_T   =     '*'   OR
                                         CHARINDEX(',' + DBO.FX_CTB_GET_FIELD_CONTENT(@ROW_CONTENT, 'I', @POS_ID_ROW_T, @LEN_ID_ROW_T, 0, '', '', @DELIMITER)+',', @ID_ROW_T) > 0    )
                             BEGIN   
                                   IF    ISNULL(@ID_ROW_DIFF, '')     =     ''    OR
                                         @ID_ROW_DIFF      =      DBO.FX_CTB_GET_FIELD_CONTENT(@ROW_CONTENT, 'I', @POS_ID_ROW_DIFF, @LEN_ID_ROW_DIFF, 0, '', '', @DELIMITER)
                                   BEGIN      
                                   
                                         SELECT      @INSERT_FIELDS    =     '', @INSERT_SCRIPT    =     ''

                                         BEGIN TRY  
                                               SELECT      @INSERT_FIELDS    =      @INSERT_FIELDS + CASE WHEN @INSERT_SCRIPT = '' THEN '' ELSE ',' END + A.DATAFIELD,
                                                           @INSERT_SCRIPT    =      @INSERT_SCRIPT + CASE WHEN @INSERT_SCRIPT = '' THEN '' ELSE ',' END +
                                                           DBO.FX_CTB_GET_FIELD_CONTENT(@ROW_CONTENT, A.DATATYPE, A.POSITION, A.DATALEN, A.DECIMALS, A.FIXED_VALUES,
                                                           CASE  WHEN  A.DATALEN   =     6      AND   LEN(@DATE_MASK)   =     8     AND   LEFT(@DATE_MASK, 1)     =     'A'   THEN      RIGHT(@DATE_MASK, 6)
                                                                       WHEN  A.DATALEN   =      6     AND   LEN(@DATE_MASK)   =     8     AND   LEFT(@DATE_MASK, 1)     <>    'A'   THEN      LEFT(@DATE_MASK, 6)
                                                                       WHEN  A.DATALEN   =      8     AND   LEN(@DATE_MASK)   =     6     AND   LEFT(@DATE_MASK, 1)     =     'A'   THEN      'AA' + @DATE_MASK
                                                                       WHEN  A.DATALEN   =      8     AND   LEN(@DATE_MASK)   =     6     AND   LEFT(@DATE_MASK, 1)     <>    'A'   THEN      @DATE_MASK + 'AA'
                                                                       ELSE  @DATE_MASK  END, @DELIMITER)
                                               FROM  @LAYOUT_FIELDS AS A
                                               WHERE A.TOPOLOGY  =     @COD_TRAN_LAYOUT
                                         END TRY
                                         BEGIN CATCH
                                               SELECT      @MSG_ERROR  =     @MSG_ERROR + CHAR(13)+CHAR(10)+'Error: ' + CONVERT(VARCHAR(20),isnull(ERROR_NUMBER(),0)) +' Message: '+ ISNULL(RTRIM(ERROR_MESSAGE()),'') +' Proc: ' + ISNULL(RTRIM(ERROR_PROCEDURE()),'')
                                               SELECT      @MSG_ERROR  =     @MSG_ERROR + ' LayOut: '+rtrim(@LAYOUT) + ' File With Problem: '+rtrim(@F_NAME)
                                               /*#3#*/
                                               /*GOTO      ENDPROC*/
                                               FETCH NEXT FROM   CUR_ROWS_LAYOUT   INTO      @ROW_CONTENT
                                               CONTINUE
                                         END CATCH  

                                         IF    ISNULL(@INSERT_FIELDS_CAB, '')     =     ''
                                               SET   @INSERT_FIELDS_CAB      =     ''
                                         ELSE
                                               IF    RIGHT(@INSERT_FIELDS_CAB, 1) <>    ','
                                                     SET   @INSERT_FIELDS_CAB      =      @INSERT_FIELDS_CAB + ','

                                         IF    ISNULL(@INSERT_SCRIPT_CAB, '')     =     ''
                                               SET   @INSERT_SCRIPT_CAB      =     ''
                                         ELSE
                                               IF    RIGHT(@INSERT_SCRIPT_CAB, 1) <>    ','
                                                     SET   @INSERT_SCRIPT_CAB      =      @INSERT_SCRIPT_CAB      +     ','

                                         IF    ISNULL(@INSERT_FIELDS_DEP, '')     =     ''
                                               SET   @INSERT_FIELDS_DEP      =     ''
                                         ELSE
                                               IF    RIGHT(@INSERT_FIELDS_DEP, 1) <>    ','
                                                     SET   @INSERT_FIELDS_DEP      =      @INSERT_FIELDS_DEP      +     ','

                                         IF    ISNULL(@INSERT_SCRIPT_DEP, '')     =     ''
                                               SET   @INSERT_SCRIPT_DEP      =     ''
                                         ELSE
                                               IF    RIGHT(@INSERT_SCRIPT_DEP, 1) <>    ','
                                                     SET   @INSERT_SCRIPT_DEP      =      @INSERT_SCRIPT_DEP      +     ','

                                         --GENERATE TEMPORARY DATA  
                                         BEGIN TRY  
                                               
                                               EXEC( 'INSERT INTO #LAYOUT_CONTENT ('    +      @INSERT_FIELDS_CAB      +     @INSERT_FIELDS_DEP      +     @INSERT_FIELDS    +     ')
                                                                                              VALUES      ('    +     @INSERT_SCRIPT_CAB      +     @INSERT_SCRIPT_DEP      +      @INSERT_SCRIPT    +     ')'   )
                                         END TRY  
                                         BEGIN CATCH         
                                               SELECT      @MSG_ERROR  =     @MSG_ERROR  +      CHAR(13) + CHAR(10) + 'LayOut: ' + RTRIM(@LAYOUT) + ' File With Problem: ' + 
                                                                                                          RTRIM(@F_NAME) +  CHAR(13)+CHAR(10) + 'Error: ' + 
                                                                                                          CONVERT(VARCHAR(20), ISNULL(ERROR_NUMBER(), 0))      +
                                                                                                          ' Message: '      + ISNULL(RTRIM(ERROR_MESSAGE()),'') +
                                                                                                          ' Proc: ' + ISNULL(RTRIM(ERROR_PROCEDURE()),'')
                                               /*#3#*/
                                               /*GOTO      ENDPROC*/
                                               FETCH NEXT FROM   CUR_ROWS_LAYOUT   INTO      @ROW_CONTENT
                                               CONTINUE
                                         END CATCH
                                         
                                         SELECT      @INSERT_FIELDS_DEP      =     '', @INSERT_SCRIPT_DEP      =     ''
                                   END  
                             END  

                             FETCH NEXT FROM   CUR_ROWS_LAYOUT   INTO  @ROW_CONTENT
                        END
                        CLOSE       CUR_ROWS_LAYOUT
                        DEALLOCATE  CUR_ROWS_LAYOUT

                        FETCH NEXT FROM   CUR_TRANSACTIONS_LAYOUT INTO  @COD_TRAN_LAYOUT, @ID_ROW_T, @POS_ID_ROW_T, @LEN_ID_ROW_T, @RECORD_NAME
                  END
                  --END READ TRANSATIONS
                  CLOSE       CUR_TRANSACTIONS_LAYOUT
                  DEALLOCATE  CUR_TRANSACTIONS_LAYOUT

                  --GENERATE DATA OF CONCILIATION
                  BEGIN TRANSACTION
                  --GET LAYOUT SEQUENCE
                  SELECT      @SEQUENCE_LAYOUT_FILE   =     NULL
                  
                  SELECT      @SEQUENCE_LAYOUT_FILE   =     ID_ARQUIVO
                  FROM  CTB_ARQ_CONCILIACAO
                  WHERE LAYOUT                  =     @LAYOUT     AND
                             NOME_ARQUIVO      =     @F_NAME

                  IF    @SEQUENCE_LAYOUT_FILE   IS    NULL
                  BEGIN
                        EXEC  LX_SEQUENCIAL     @TABELA_COLUNA    =      'CTB_ARQ_CONCILIACAO.ID_ARQUIVO', 
                                                           @EMPRESA          =     0,
                                                           @SEQUENCIA        =      @SEQUENCE_LAYOUT_FILE   OUTPUT

                        INSERT INTO CTB_ARQ_CONCILIACAO     (     ID_ARQUIVO, NOME_ARQUIVO, DATA_RECEBIMENTO, REDE, LAYOUT, STATUS   )
                                                           VALUES      (      @SEQUENCE_LAYOUT_FILE, @F_NAME, CONVERT(VARCHAR(8), GETDATE(), 112), NULL, @LAYOUT, 0      )
                  END

                  --COPY CONTENT FILE TO DATABASE
                  SELECT      @SCRIPT_TO_EXEC   =     'EXEC '     +     @EXTERNAL_PROCEDURE      +     ' '   +     CONVERT(VARCHAR(20), @SEQUENCE_LAYOUT_FILE)
                  BEGIN TRY
                        EXECUTE(@SCRIPT_TO_EXEC)
      
                        COMMIT TRANSACTION

                        --ALERT FILE TO MOVE
                        IF    @MOVE_FILE  =     1     AND
                             NOT EXISTS  (     SELECT      1     FROM  @FILES_TO_MOVE    WHERE      FULL_FILE_PATH    =     @FULL_FILE_PATH   )
                             INSERT INTO @FILES_TO_MOVE    (     DIRECTORY, FULL_FILE_PATH, FULL_MOVE_PATH    )
                                                           VALUES      (      @DIRETORIO_ARQUIVO, @FULL_FILE_PATH, @FULL_MOVE_PATH )
                  END TRY  
                  BEGIN CATCH  
                        SELECT      @MSG_ERROR  =     @MSG_ERROR  + CHAR(13) + CHAR(10)   +      'LayOut: '  +     RTRIM(@LAYOUT)    +     ' File With Problem: '  +
                                                           RTRIM(@F_NAME)    +     ' Executing Proc '      +     RTRIM(@EXTERNAL_PROCEDURE)   +     CHAR(13) + CHAR(10) +
                                                           'Error: '   +      CONVERT(VARCHAR(20), ISNULL(ERROR_NUMBER(), 0))      +     ' Message: '      +     
                                                           ISNULL(RTRIM(ERROR_MESSAGE()), '')      +     ' Proc: '   +     ISNULL(RTRIM(ERROR_PROCEDURE()), '')
                        WHILE @@TRANCOUNT >     0
                             ROLLBACK    TRANSACTION
                  END CATCH

                  FETCH NEXT FROM   CUR_FILES_LAYOUT  INTO  @F_NAME
            END
            CLOSE       CUR_FILES_LAYOUT
            DEALLOCATE  CUR_FILES_LAYOUT

            --TRUNCATE FILES READED
            TRUNCATE TABLE    #FILES_READED
            DELETE      FROM  @LAYOUT_FIELDS
            --DELETE TABLE LAYOUT CONTENT
            DROP TABLE  #LAYOUT_CONTENT

            FETCH NEXT FROM   CUR_LAYOUTS INTO  @LAYOUT, @DATE_MASK, @DELIMITER, @DIRETORIO_ARQUIVO, @TIPO_CONCILIACAO
      END
      CLOSE       CUR_LAYOUTS
      DEALLOCATE  CUR_LAYOUTS

ENDPROC:

      SET NOCOUNT OFF

      --IF  @MSG_ERROR  =     '' --#1#
      --BEGIN  
            IF    @MOVE_FILE  =     1
            BEGIN
                  DECLARE     CUR_FILES_TO_MOVE CURSOR READ_ONLY FAST_FORWARD LOCAL FOR
                        SELECT      DISTINCT
                                   FULL_FILE_PATH, FULL_MOVE_PATH
                        FROM  @FILES_TO_MOVE
                        ORDER BY    FULL_FILE_PATH

                  OPEN  CUR_FILES_TO_MOVE
                  FETCH NEXT FROM   CUR_FILES_TO_MOVE INTO  @FULL_FILE_PATH, @FULL_MOVE_PATH
                  WHILE @@FETCH_STATUS    =     0
                  BEGIN
                        EXEC  lx_FSOMoveFile    @FULL_FILE_PATH, @FULL_MOVE_PATH
                  
                        FETCH NEXT FROM   CUR_FILES_TO_MOVE INTO  @FULL_FILE_PATH, @FULL_MOVE_PATH
                  END
                  CLOSE       CUR_FILES_TO_MOVE
                  DEALLOCATE  CUR_FILES_TO_MOVE
            END
