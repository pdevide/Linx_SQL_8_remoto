SCHEMA BANCO DE DADOS	: dbo

OBJETO COM PROBLEMA	: LX_CTB_MOVIMENTO_CONTA_CORRENTE

DESCRIÇÃO DO PROBLEMA	: LX_CTB_MOVIMENTO_CONTA_CORRENTE -- Invalid object name 'CTB_BALANCETE_SALDO_ANTERIOR'.

CONTEÚDO DO OBJETO		: 
CREATE PROCEDURE [dbo].[LX_CTB_MOVIMENTO_CONTA_CORRENTE] 
							@DATA_INICIAL		DATETIME,
							@DATA_FINAL			DATETIME,
							@TIPO				   CHAR(1),
							@EMPRESA			   INT			   = NULL,
							@CONTA_CONTABIL	VARCHAR(20)	   = NULL,
							@TIPO_MOVIMENTO	INT			   = NULL,
							@USAR_LIMITE		INT            = NULL,
							@FILTRA_CONTA     VARCHAR(MAX)  = NULL,
							@FILTRA_COD_MATRIZ	CHAR(6) = NULL, 
							@FILTRA_COD_FILIAL	CHAR(6) = NULL	
AS
-- 17/01/2012 - DANIEL GONCALVES - TP[2206274] - ALTERAÇÃO NO TAMANHO DO CAMPO/VARIAVEL @FILTRA_CONTA DE VARCHAR (1000) PARA (MAX).
-- 06/04/2011 - ALEX BORTOTO - CORRIGIDO POSICAO DO UPDATE QUE ATUALIZAVA O SALDO DA CONTA PARA NAO DUPLICAR OS VALORES
--							 - NO TIPO "S"
-- 07/03/2011 - LETÍCIA		 - INCLUSÃO DOS PARÂMETRO @FILTRA_COD_MATRIZ E @FILTRA_COD_FILIAL AOS FILTROS 
-- 16/12/2010 - JOAO RICARDO - PERFORMANCE
-- 24/11/2010 - ADRIANO RODRIGUES - MELHORA DE PERFORMANCE DA PROCEDURE
-- 17/06/2010 - LETÍCIA		 - INCLUSÃO DO CAMPO NUMERO_CHEQUE  
-- 29/10/2009 - JOAO RICARDO - MELHORIA DE PERFORMANCE
-- 01/04/2008 - JOAO RICARDO - INCLUINDO A MATRIZ CONTÁBIL NAS CONSULTAS
-- 19/03/2008 - JOAO RICARDO - TRATAMENTO DE MATRIZ CONTABIL POR USUÁRIO
-- 21/06/2007 - ADRIANO      - INCLUIR O CAMPO PREVISAO_DESPESA
-- 27/03/2007 - JOAO RICARDO - FILTRAR MAIS DE UMA CONTA CORRENTE
-- 13/12/2006 - JOAO RICARDO - INVERTER NO WHERE QUANDO VERIFICA A VARIAVEL NULL
-- 12/09/2006 - JOAO RICARDO - TRATAMENTO PARA SALDO BLOQUEADO
-- 24/02/2006 - ADRIANO      - INCLUSÃO DO CAMPO MOEDA
-- 29/09/2005 - JOAO RICARDO - TIPO MOVIMENTO NO RESULTADO
-- 28/09/2005 - JOAO RICARDO - PROBLEMA NOS CHEQUES EM ABERTO
-- 28/09/2005 - joao ricardo - faltava os filtros para o select de cheques
-- 27/09/2005 - JOAO RICARDO - criado mais um tipo N para resultado do movimento por conta  
-- 27/09/2005 - Sergio       - Alterado o collate de SQL_Latin1_General_CP1_CI_AS para COLLATE DATABASE_DEFAULT

SET NOCOUNT ON
SET TRANSACTION ISOLATION LEVEL READ UNCOMMITTED
-- S - SALDO POR FILIAL
-- M - MOVIMENTO DA CONTA CORRENTE POR FILIAL
-- N - MOVIMENTO DA CONTA CORRENTE

DECLARE 	@ERRMSG						VARCHAR(100),
			@WHILE						VARCHAR(200),
			@SALDO_ANTERIOR				DECIMAL(19,2),
			@COUNT						INT,
			@EMPRESA_CUR 				INT,
			@LANCAMENTO_CUR				INT,
			@ITEM_CUR					INT,
			@CONTA_CONTABIL_CUR			VARCHAR(20),
			@MOEDA_CUR					CHAR(6),
			@COD_FILIAL_CUR				VARCHAR(15),
			@DATA_LANCAMENTO_CUR		DATETIME,
			@VALOR_CUR					DECIMAL(19,2),
			@VALOR_MOEDA_CUR			DECIMAL(19,2),
			@TIPO_MOVIMENTO_CUR			INT,
			@USUARIO					VARCHAR(25),
			@DATA_FINAL_SALDO_ANTERIOR	DATETIME,
			@DATA_INICIAL_PERIODO		DATETIME,
			@DATA_FINAL_PERIODO			DATETIME
			

SELECT @DATA_FINAL_SALDO_ANTERIOR	= DBO.FX_ULTIMO_DIA_DO_MES(DATEADD(month, -1, @DATA_INICIAL)) 
SELECT @DATA_INICIAL_PERIODO		= DBO.FX_ULTIMO_DIA_DO_MES(DATEADD(month, -1, @DATA_INICIAL))
SELECT @DATA_INICIAL_PERIODO		= @DATA_INICIAL_PERIODO + 1
SELECT @DATA_FINAL_PERIODO			= @DATA_FINAL
	
SELECT @USUARIO					= USUARIO FROM USERS WHERE LX_SYSTEM_USER = SYSTEM_USER

DECLARE @FILTRO_CONTA			VARCHAR(8000), 
		@CONTADOR				INT, 
		@CONTA_CONTABIL_FILTRO	VARCHAR(20)

SELECT @CONTADOR = 1
SELECT @CONTA_CONTABIL_FILTRO = ''
SELECT @FILTRO_CONTA = @FILTRA_CONTA

CREATE TABLE #CONTA_CONTABIL (CONTA_CONTABIL VARCHAR(20) COLLATE DATABASE_DEFAULT)

WHILE @CONTADOR <= LEN(@FILTRO_CONTA)
	BEGIN
		
		IF SUBSTRING(@FILTRO_CONTA, @CONTADOR, 1) <> '[' AND SUBSTRING(@FILTRO_CONTA, @CONTADOR, 1) <> ' ' and SUBSTRING(@FILTRO_CONTA, @CONTADOR, 1) <> '/'
			BEGIN
				IF SUBSTRING(@FILTRO_CONTA, @CONTADOR, 1) = ']' AND RTRIM(LTRIM(@CONTA_CONTABIL)) <> ''
					BEGIN
						IF @CONTA_CONTABIL <> ']'
							INSERT #CONTA_CONTABIL (CONTA_CONTABIL) VALUES(@CONTA_CONTABIL_FILTRO)
							
						SELECT @CONTA_CONTABIL_FILTRO = ''
					END
				ELSE
					BEGIN
						IF RTRIM(LTRIM(SUBSTRING(@FILTRO_CONTA, @CONTADOR, 1))) <> ''
							SELECT @CONTA_CONTABIL_FILTRO = @CONTA_CONTABIL_FILTRO + SUBSTRING(@FILTRO_CONTA, @CONTADOR, 1) 
					END	
			END
		
		SELECT @CONTADOR = @CONTADOR + 1
	END

-------------------------------------------------------------------------------------------------------------------------------------------
-- CRIAR TABELAS TEMPORÁRIAS PARA MELHORA DE PERFORMANCE
CREATE TABLE	#FILIAL_MATRIZ_CONTABIL_TEMP		(	COD_MATRIZ_CONTABIL	CHAR(6)		COLLATE	DATABASE_DEFAULT,
														MATRIZ_CONTABIL		VARCHAR(25)	COLLATE	DATABASE_DEFAULT,
														COD_FILIAL			CHAR(6)		COLLATE	DATABASE_DEFAULT,
														FILIAL				VARCHAR(25)	COLLATE	DATABASE_DEFAULT	)

CREATE INDEX	IX_CHAVE_COD_FILIAL			ON	#FILIAL_MATRIZ_CONTABIL_TEMP	(	COD_FILIAL	)
CREATE INDEX	IX_CHAVE_FILIAL				ON	#FILIAL_MATRIZ_CONTABIL_TEMP	(	FILIAL	)

INSERT INTO	#FILIAL_MATRIZ_CONTABIL_TEMP	(	COD_MATRIZ_CONTABIL, MATRIZ_CONTABIL, COD_FILIAL, FILIAL	)
SELECT	A.COD_FILIAL, A.FILIAL, B.COD_FILIAL, B.FILIAL
FROM	FILIAIS AS A
		JOIN	FILIAIS AS B	ON	A.FILIAL	=	B.MATRIZ

--
CREATE TABLE	#RATEIO_FILIAL_MATRIZ_CONTABIL_TEMP	(	RATEIO_FILIAL		VARCHAR(15)	COLLATE	DATABASE_DEFAULT,
														COD_MATRIZ_CONTABIL	CHAR(6)		COLLATE	DATABASE_DEFAULT	)

CREATE INDEX IX_CHAVE						ON	#RATEIO_FILIAL_MATRIZ_CONTABIL_TEMP	(	RATEIO_FILIAL, COD_MATRIZ_CONTABIL	)
CREATE INDEX IX_CHAVE_RATEIO_FILIAL			ON	#RATEIO_FILIAL_MATRIZ_CONTABIL_TEMP	(	RATEIO_FILIAL	)
CREATE INDEX IX_CHAVE_COD_MATRIZ_CONTABIL	ON	#RATEIO_FILIAL_MATRIZ_CONTABIL_TEMP	(	COD_MATRIZ_CONTABIL	)

INSERT INTO	#RATEIO_FILIAL_MATRIZ_CONTABIL_TEMP	(	RATEIO_FILIAL, COD_MATRIZ_CONTABIL	)
SELECT	RATEIO_FILIAL, COD_MATRIZ_CONTABIL
FROM	W_CTB_RATEIO_FILIAL_MATRIZ_CONTABIL

--
CREATE	TABLE	#USERS_MATRIZ_CONTABIL_TEMP			(	COD_MATRIZ_CONTABIL	CHAR(6)		COLLATE	DATABASE_DEFAULT	)

CREATE INDEX IX_CHAVE_COD_MATRIZ_CONTABIL	ON	#USERS_MATRIZ_CONTABIL_TEMP	(	COD_MATRIZ_CONTABIL	)

INSERT INTO	#USERS_MATRIZ_CONTABIL_TEMP(	COD_MATRIZ_CONTABIL	)
SELECT	COD_MATRIZ_CONTABIL
FROM	DBO.FX_USERS_MATRIZ_CONTABIL(@USUARIO)
-------------------------------------------------------------------------------------------------------------------------------------------

IF @TIPO = 'S'
	BEGIN
		CREATE TABLE #SALDO_ATUAL_CONTA
			(	EMPRESA						INT,
				CONTA_CONTABIL 				VARCHAR(20)  	COLLATE DATABASE_DEFAULT,
				DESC_CONTA					VARCHAR(40)  	COLLATE DATABASE_DEFAULT,
				COD_FILIAL					VARCHAR(6)  	COLLATE DATABASE_DEFAULT,
				FILIAL						VARCHAR(25)  	COLLATE DATABASE_DEFAULT,
				MOEDA						CHAR(6)			COLLATE DATABASE_DEFAULT,
				SALDO_ATUAL					DECIMAL(19,2),
				SALDO_EM_CHEQUES			DECIMAL(19,2),
				DATA_ULTIMO_LANCTO			DATETIME,
				LIMITE_CONTA_CORRENTE		DECIMAL(19,2),
				SALDO_BLOQ_CONTA_CORRENTE	DECIMAL(19,2),
				PREVISAO_DESPESA			DECIMAL(19,2),
				COD_MATRIZ_CONTABIL			VARCHAR(6)		COLLATE DATABASE_DEFAULT, 
				NUMERO_CHEQUE				VARCHAR(10)		COLLATE DATABASE_DEFAULT
			)			
								
		CREATE  INDEX #XIE1SALDO_ATUAL_CONTA ON #SALDO_ATUAL_CONTA(EMPRESA, CONTA_CONTABIL, COD_FILIAL) WITH  FILLFACTOR = 10 ON [PRIMARY]
					
		CREATE TABLE #SALDO_ATUAL_CONTA_TEMP
			(	EMPRESA						INT,
				CONTA_CONTABIL 				VARCHAR(20)  	COLLATE DATABASE_DEFAULT,
				DESC_CONTA					VARCHAR(40)  	COLLATE DATABASE_DEFAULT,
				COD_FILIAL					VARCHAR(6)  	COLLATE DATABASE_DEFAULT,
				FILIAL						VARCHAR(25)  	COLLATE DATABASE_DEFAULT,
				MOEDA						CHAR(6)			COLLATE DATABASE_DEFAULT,
				SALDO_ATUAL					DECIMAL(19,2),
				SALDO_EM_CHEQUES			DECIMAL(19,2),
				DATA_ULTIMO_LANCTO			DATETIME,
				LIMITE_CONTA_CORRENTE		DECIMAL(19,2),
				SALDO_BLOQ_CONTA_CORRENTE	DECIMAL(19,2),
				PREVISAO_DESPESA			DECIMAL(19,2),
				COD_MATRIZ_CONTABIL			VARCHAR(6)		COLLATE DATABASE_DEFAULT, 
				NUMERO_CHEQUE				VARCHAR(10)		COLLATE DATABASE_DEFAULT
			)			

		CREATE  INDEX #XIE1SALDO_ATUAL_CONTA_TEMP ON #SALDO_ATUAL_CONTA_TEMP(EMPRESA, CONTA_CONTABIL, COD_FILIAL) WITH  FILLFACTOR = 10 ON [PRIMARY]
		
		IF RTRIM(LTRIM(@CONTA_CONTABIL)) = 'SEM CONTA'
			BEGIN
							
				DECLARE CUR_CONTAS_FILTROS CURSOR LOCAL FAST_FORWARD FOR
				SELECT LTRIM(RTRIM(CONTA_CONTABIL)) FROM #CONTA_CONTABIL WHERE LTRIM(RTRIM(CONTA_CONTABIL)) <> ''
				
				OPEN CUR_CONTAS_FILTROS
				
				FETCH NEXT FROM CUR_CONTAS_FILTROS
				INTO @CONTA_CONTABIL_FILTRO
				
				WHILE @@FETCH_STATUS = 0
					BEGIN
					
						-- BUSCANDO TABELA SALDO ANTERIOR					
						INSERT #SALDO_ATUAL_CONTA 
								(	EMPRESA, 
									CONTA_CONTABIL, 
									DESC_CONTA, 
									COD_FILIAL, 
									FILIAL, 
									MOEDA,
									SALDO_ATUAL, 
									DATA_ULTIMO_LANCTO, 
									SALDO_EM_CHEQUES,
									LIMITE_CONTA_CORRENTE,
									SALDO_BLOQ_CONTA_CORRENTE,
									PREVISAO_DESPESA,
									COD_MATRIZ_CONTABIL,
									NUMERO_CHEQUE
								) 
						SELECT 	A.EMPRESA, 
									A.CONTA_CONTABIL, 
									B.DESC_CONTA,
									COD_FILIAL						= A.COD_FILIAL, 
									FILIAL							= D.FILIAL,
									MOEDA							= B.MOEDA,
									SALDO_ATUAL						= SUM(A.DEBITO) - SUM(A.CREDITO)+CASE WHEN @USAR_LIMITE = 1 THEN MAX(ISNULL(B.LIMITE_CONTA_CORRENTE,0.00)) ELSE 0.00 END, 
									DATA_ULTIMO_LANCTO				= NULL, 
									0.00,
									LIMITE_CONTA_CORRENTE			= MAX(ISNULL(LIMITE_CONTA_CORRENTE,0.00)),
									SALDO_BLOQ_CONTA_CORRENTE		= MAX(ISNULL(SALDO_BLOQ_CONTA_CORRENTE,0.00)),
									PREVISAO_DESPESA				= MAX(ISNULL(B.PREVISAO_DESPESA,0.00)),
									COD_MATRIZ_CONTABIL				= D.COD_MATRIZ_CONTABIL,
									B.ULTIMO_CHEQUE
						FROM W_CTB_BALANCETE_SALDO_ANTERIOR A (NOLOCK)
							JOIN CTB_CONTA_PLANO B (NOLOCK) ON
							   A.CONTA_CONTABIL     = B.CONTA_CONTABIL
							JOIN #FILIAL_MATRIZ_CONTABIL_TEMP D ON
								A.COD_FILIAL	= D.COD_FILIAL
							JOIN #USERS_MATRIZ_CONTABIL_TEMP E ON
								D.COD_MATRIZ_CONTABIL			= E.COD_MATRIZ_CONTABIL
						WHERE	A.DATA_SALDO 		<= @DATA_FINAL_SALDO_ANTERIOR									AND
								(@EMPRESA 			IS NULL     OR A.EMPRESA				= @EMPRESA 			)	AND
								 A.CONTA_CONTABIL	= @CONTA_CONTABIL_FILTRO										AND
								(@TIPO_MOVIMENTO 	IS NULL     OR A.TIPO_MOVIMENTO		= @TIPO_MOVIMENTO	)		AND
								(@FILTRA_COD_MATRIZ	IS NULL		OR D.COD_MATRIZ_CONTABIL	= @FILTRA_COD_MATRIZ)	AND
								(@FILTRA_COD_FILIAL	IS NULL		OR A.COD_FILIAL			=	  @FILTRA_COD_FILIAL)	
						GROUP BY A.EMPRESA, A.CONTA_CONTABIL, B.DESC_CONTA, A.COD_FILIAL, D.FILIAL, B.MOEDA, D.COD_MATRIZ_CONTABIL, B.ULTIMO_CHEQUE

						DELETE #SALDO_ATUAL_CONTA_TEMP
						
						INSERT #SALDO_ATUAL_CONTA_TEMP 
								(	EMPRESA, 
									CONTA_CONTABIL, 
									DESC_CONTA, 
									COD_FILIAL, 
									FILIAL, 
									MOEDA,
									SALDO_ATUAL, 
									DATA_ULTIMO_LANCTO, 
									SALDO_EM_CHEQUES,
									LIMITE_CONTA_CORRENTE,
									SALDO_BLOQ_CONTA_CORRENTE,
									PREVISAO_DESPESA,
									COD_MATRIZ_CONTABIL,
									NUMERO_CHEQUE
								) 
						SELECT 		A.EMPRESA, 
									A2.CONTA_CONTABIL, 
									B.DESC_CONTA,
									COD_FILIAL						= A.COD_FILIAL, 
									FILIAL							= D.FILIAL,
									MOEDA							= A2.MOEDA,
									SALDO_ATUAL						= SUM(A.DEBITO)-SUM(A.CREDITO)+CASE WHEN @USAR_LIMITE = 1 THEN MAX(ISNULL(B.LIMITE_CONTA_CORRENTE,0.00)) ELSE 0.00 END, 
									DATA_ULTIMO_LANCTO				= MAX(A1.DATA_LANCAMENTO), 
									0.00,
									LIMITE_CONTA_CORRENTE			= MAX(ISNULL(LIMITE_CONTA_CORRENTE,0.00)),
									SALDO_BLOQ_CONTA_CORRENTE		= MAX(ISNULL(SALDO_BLOQ_CONTA_CORRENTE,0.00)),
									PREVISAO_DESPESA				= MAX(ISNULL(B.PREVISAO_DESPESA,0.00)),
									COD_FILIAL						= D.COD_MATRIZ_CONTABIL,
									B.ULTIMO_CHEQUE
						FROM CTB_LANCAMENTO_RATEIO A (NOLOCK)
								JOIN CTB_LANCAMENTO A1 (NOLOCK) ON
									A.EMPRESA		= A1.EMPRESA		AND
									A.LANCAMENTO	= A1.LANCAMENTO		
								JOIN CTB_LANCAMENTO_ITEM A2 (NOLOCK) ON
									A.EMPRESA		= A2.EMPRESA		AND
									A.LANCAMENTO	= A2.LANCAMENTO		AND
									A.ITEM			= A2.ITEM		
								JOIN CTB_CONTA_PLANO B (NOLOCK) ON
								   A2.CONTA_CONTABIL     = B.CONTA_CONTABIL
								JOIN #FILIAL_MATRIZ_CONTABIL_TEMP D ON
									A.COD_FILIAL	= D.COD_FILIAL
								JOIN #USERS_MATRIZ_CONTABIL_TEMP E ON
									D.COD_MATRIZ_CONTABIL			= E.COD_MATRIZ_CONTABIL
						WHERE	A1.DATA_LANCAMENTO		>= @DATA_INICIAL_PERIODO		AND
								A1.DATA_LANCAMENTO 		<= @DATA_FINAL_PERIODO			AND
								(@EMPRESA 			IS NULL     OR A.EMPRESA				= @EMPRESA 			)	AND
								 A2.CONTA_CONTABIL	= @CONTA_CONTABIL_FILTRO										AND
								(@TIPO_MOVIMENTO 	IS NULL     OR A1.TIPO_MOVIMENTO		= @TIPO_MOVIMENTO	)	AND
								(@FILTRA_COD_MATRIZ	IS NULL		OR D.COD_MATRIZ_CONTABIL	= @FILTRA_COD_MATRIZ)	AND
								(@FILTRA_COD_FILIAL	IS NULL		OR A.COD_FILIAL			=	  @FILTRA_COD_FILIAL)	
						GROUP BY A.EMPRESA, A2.CONTA_CONTABIL, B.DESC_CONTA, A.COD_FILIAL, D.FILIAL, A2.MOEDA, D.COD_MATRIZ_CONTABIL, B.ULTIMO_CHEQUE

						UPDATE B SET
							SALDO_ATUAL			= B.SALDO_ATUAL + ISNULL(A.SALDO_ATUAL,0),
							DATA_ULTIMO_LANCTO	= ISNULL(A.DATA_ULTIMO_LANCTO,B.DATA_ULTIMO_LANCTO)
						FROM #SALDO_ATUAL_CONTA_TEMP A
								JOIN #SALDO_ATUAL_CONTA B ON
									A.EMPRESA			= B.EMPRESA			AND
									A.CONTA_CONTABIL	= B.CONTA_CONTABIL	AND
									A.COD_FILIAL		= B.COD_FILIAL

						INSERT #SALDO_ATUAL_CONTA 
								(	EMPRESA, 
									CONTA_CONTABIL, 
									DESC_CONTA, 
									COD_FILIAL, 
									FILIAL, 
									MOEDA,
									SALDO_ATUAL, 
									DATA_ULTIMO_LANCTO, 
									SALDO_EM_CHEQUES,
									LIMITE_CONTA_CORRENTE,
									SALDO_BLOQ_CONTA_CORRENTE,
									PREVISAO_DESPESA,
									COD_MATRIZ_CONTABIL,
									NUMERO_CHEQUE
								) 					
						SELECT		A.EMPRESA, 
									A.CONTA_CONTABIL, 
									A.DESC_CONTA, 
									A.COD_FILIAL, 
									A.FILIAL, 
									A.MOEDA,
									A.SALDO_ATUAL, 
									A.DATA_ULTIMO_LANCTO, 
									A.SALDO_EM_CHEQUES,
									A.LIMITE_CONTA_CORRENTE,
									A.SALDO_BLOQ_CONTA_CORRENTE,
									A.PREVISAO_DESPESA,
									A.COD_MATRIZ_CONTABIL,
									A.NUMERO_CHEQUE
						FROM #SALDO_ATUAL_CONTA_TEMP A
								LEFT JOIN #SALDO_ATUAL_CONTA B ON
									A.EMPRESA			= B.EMPRESA			AND
									A.CONTA_CONTABIL	= B.CONTA_CONTABIL	AND
									A.COD_FILIAL		= B.COD_FILIAL
						WHERE B.EMPRESA IS NULL			

						-- ALEX - COMENTADO POIS ESTAVA GERANDO DUPLICIDADE E INCLUIDO ANTES DO INSERT
						--UPDATE B SET
						--	SALDO_ATUAL			= B.SALDO_ATUAL + ISNULL(A.SALDO_ATUAL,0),
						--	DATA_ULTIMO_LANCTO	= ISNULL(A.DATA_ULTIMO_LANCTO,B.DATA_ULTIMO_LANCTO)
						--FROM #SALDO_ATUAL_CONTA_TEMP A
						--		JOIN #SALDO_ATUAL_CONTA B ON
						--			A.EMPRESA			= B.EMPRESA			AND
						--			A.CONTA_CONTABIL	= B.CONTA_CONTABIL	AND
						--			A.COD_FILIAL		= B.COD_FILIAL
									
				
						UPDATE D SET SALDO_EM_CHEQUES = A.SALDO_CHEQUES
						FROM #SALDO_ATUAL_CONTA D
								JOIN (		SELECT A.EMPRESA, A.CONTA_CONTABIL AS CONTA_CONTABIL, B.COD_FILIAL AS COD_FILIAL_RATEIO, CAST(SUM(CREDITO+DEBITO) AS DECIMAL(19,2)) AS SALDO_CHEQUES
													FROM CTB_CHEQUE A (NOLOCK)
															JOIN W_CTB_CHEQUE_SALDO A1 (NOLOCK) ON
																A.EMPRESA			= A1.EMPRESA			AND
																A.LANCAMENTO		= A1.LANCAMENTO			AND
																A.ITEM				= A1.ITEM	
															JOIN CTB_LANCAMENTO_RATEIO B (NOLOCK) ON
																A.EMPRESA				= B.EMPRESA 		AND
																A.LANCAMENTO 			= B.LANCAMENTO		AND
																A.ITEM					= B.ITEM
															JOIN CTB_LANCAMENTO B1 (NOLOCK) ON
																B.EMPRESA				= B1.EMPRESA		AND
																B.LANCAMENTO			= B1.LANCAMENTO
															JOIN #FILIAL_MATRIZ_CONTABIL_TEMP D1 ON
																B.COD_FILIAL	= D1.COD_FILIAL																			
															JOIN #USERS_MATRIZ_CONTABIL_TEMP C ON
																D1.COD_MATRIZ_CONTABIL			= C.COD_MATRIZ_CONTABIL
													WHERE	A1.VALOR_A_PAGAR > 0 								AND
															DBO.LX_DATA_REAL(NULL,A.VENCIMENTO) 		<= @DATA_FINAL		AND
															(@EMPRESA 				IS NULL     OR A.EMPRESA				= @EMPRESA 			)	AND
															A.CONTA_CONTABIL		= @CONTA_CONTABIL_FILTRO										AND
															(@TIPO_MOVIMENTO 		IS NULL     OR B1.TIPO_MOVIMENTO		= @TIPO_MOVIMENTO	)	AND						
															(@FILTRA_COD_MATRIZ		IS NULL		OR D1.COD_MATRIZ_CONTABIL	= @FILTRA_COD_MATRIZ)	AND
															(@FILTRA_COD_FILIAL		IS NULL		OR B.COD_FILIAL			=	  @FILTRA_COD_FILIAL)	
										GROUP BY A.EMPRESA, A.CONTA_CONTABIL, B.COD_FILIAL	
										) A ON 
									A.EMPRESA				= D.EMPRESA				AND
									A.CONTA_CONTABIL		= D.CONTA_CONTABIL	AND
									A.COD_FILIAL_RATEIO		= D.COD_FILIAL
						WHERE a.CONTA_CONTABIL = 	@CONTA_CONTABIL_FILTRO				
									
						FETCH NEXT FROM CUR_CONTAS_FILTROS
						INTO @CONTA_CONTABIL_FILTRO
					
					END	

				CLOSE CUR_CONTAS_FILTROS
				DEALLOCATE CUR_CONTAS_FILTROS
			END
		ELSE
			BEGIN	
				
						-- BUSCANDO TABELA SALDO ANTERIOR					
						INSERT #SALDO_ATUAL_CONTA 
								(	EMPRESA, 
									CONTA_CONTABIL, 
									DESC_CONTA, 
									COD_FILIAL, 
									FILIAL, 
									MOEDA,
									SALDO_ATUAL, 
									DATA_ULTIMO_LANCTO, 
									SALDO_EM_CHEQUES,
									LIMITE_CONTA_CORRENTE,
									SALDO_BLOQ_CONTA_CORRENTE,
									PREVISAO_DESPESA,
									COD_MATRIZ_CONTABIL,
									NUMERO_CHEQUE
								) 
						SELECT 	A.EMPRESA, 
									A.CONTA_CONTABIL, 
									B.DESC_CONTA,
									COD_FILIAL						= A.COD_FILIAL, 
									FILIAL							= D.FILIAL,
									MOEDA							= B.MOEDA,
									SALDO_ATUAL						= SUM(A.DEBITO) - SUM(A.CREDITO)+CASE WHEN @USAR_LIMITE = 1 THEN MAX(ISNULL(B.LIMITE_CONTA_CORRENTE,0.00)) ELSE 0.00 END, 
									DATA_ULTIMO_LANCTO				= NULL, 
									0.00,
									LIMITE_CONTA_CORRENTE			= MAX(ISNULL(LIMITE_CONTA_CORRENTE,0.00)),
									SALDO_BLOQ_CONTA_CORRENTE		= MAX(ISNULL(SALDO_BLOQ_CONTA_CORRENTE,0.00)),
									PREVISAO_DESPESA				= MAX(ISNULL(B.PREVISAO_DESPESA,0.00)),
									COD_MATRIZ_CONTABIL				= D.COD_MATRIZ_CONTABIL,
									B.ULTIMO_CHEQUE
						FROM W_CTB_BALANCETE_SALDO_ANTERIOR A (NOLOCK)
							JOIN CTB_CONTA_PLANO B (NOLOCK) ON
							   A.CONTA_CONTABIL     = B.CONTA_CONTABIL
							JOIN #FILIAL_MATRIZ_CONTABIL_TEMP D ON
								A.COD_FILIAL	= D.COD_FILIAL
							JOIN #USERS_MATRIZ_CONTABIL_TEMP E ON
								D.COD_MATRIZ_CONTABIL			= E.COD_MATRIZ_CONTABIL
						WHERE	A.DATA_SALDO 		<= @DATA_FINAL_SALDO_ANTERIOR									AND
								(@EMPRESA 			IS NULL     OR A.EMPRESA			= @EMPRESA 			)		AND
								 A.CONTA_CONTABIL	= @CONTA_CONTABIL												AND
								(@TIPO_MOVIMENTO 	IS NULL     OR A.TIPO_MOVIMENTO			= @TIPO_MOVIMENTO	)	AND
								(@FILTRA_COD_MATRIZ	IS NULL		OR D.COD_MATRIZ_CONTABIL	= @FILTRA_COD_MATRIZ)	AND
								(@FILTRA_COD_FILIAL	IS NULL		OR A.COD_FILIAL				= @FILTRA_COD_FILIAL)	
						GROUP BY A.EMPRESA, A.CONTA_CONTABIL, B.DESC_CONTA, A.COD_FILIAL, D.FILIAL, B.MOEDA, D.COD_MATRIZ_CONTABIL, B.ULTIMO_CHEQUE

						DELETE #SALDO_ATUAL_CONTA_TEMP
						
						INSERT #SALDO_ATUAL_CONTA_TEMP 
								(	EMPRESA, 
									CONTA_CONTABIL, 
									DESC_CONTA, 
									COD_FILIAL, 
									FILIAL, 
									MOEDA,
									SALDO_ATUAL, 
									DATA_ULTIMO_LANCTO, 
									SALDO_EM_CHEQUES,
									LIMITE_CONTA_CORRENTE,
									SALDO_BLOQ_CONTA_CORRENTE,
									PREVISAO_DESPESA,
									COD_MATRIZ_CONTABIL,
									NUMERO_CHEQUE
								) 
						SELECT 		A.EMPRESA, 
									A2.CONTA_CONTABIL, 
									B.DESC_CONTA,
									COD_FILIAL						= A.COD_FILIAL, 
									FILIAL							= D.FILIAL,
									MOEDA							= A2.MOEDA,
									SALDO_ATUAL						= SUM(A.DEBITO)-SUM(A.CREDITO)+CASE WHEN @USAR_LIMITE = 1 THEN MAX(ISNULL(B.LIMITE_CONTA_CORRENTE,0.00)) ELSE 0.00 END, 
									DATA_ULTIMO_LANCTO				= MAX(A1.DATA_LANCAMENTO), 
									0.00,
									LIMITE_CONTA_CORRENTE			= MAX(ISNULL(LIMITE_CONTA_CORRENTE,0.00)),
									SALDO_BLOQ_CONTA_CORRENTE		= MAX(ISNULL(SALDO_BLOQ_CONTA_CORRENTE,0.00)),
									PREVISAO_DESPESA				= MAX(ISNULL(B.PREVISAO_DESPESA,0.00)),
									COD_FILIAL						= D.COD_MATRIZ_CONTABIL,
									B.ULTIMO_CHEQUE
						FROM CTB_LANCAMENTO_RATEIO A (NOLOCK)
								JOIN CTB_LANCAMENTO A1 (NOLOCK) ON
									A.EMPRESA		= A1.EMPRESA		AND
									A.LANCAMENTO	= A1.LANCAMENTO		
								JOIN CTB_LANCAMENTO_ITEM A2 (NOLOCK) ON
									A.EMPRESA		= A2.EMPRESA		AND
									A.LANCAMENTO	= A2.LANCAMENTO		AND
									A.ITEM			= A2.ITEM		
								JOIN CTB_CONTA_PLANO B (NOLOCK) ON
								   A2.CONTA_CONTABIL     = B.CONTA_CONTABIL
								JOIN #FILIAL_MATRIZ_CONTABIL_TEMP D ON
									A.COD_FILIAL	= D.COD_FILIAL
								JOIN #USERS_MATRIZ_CONTABIL_TEMP E ON
									D.COD_MATRIZ_CONTABIL			= E.COD_MATRIZ_CONTABIL
						WHERE	A1.DATA_LANCAMENTO		>= @DATA_INICIAL_PERIODO		AND
								A1.DATA_LANCAMENTO 		<= @DATA_FINAL_PERIODO			AND
								(@EMPRESA 			IS NULL     OR A.EMPRESA				= @EMPRESA 			)	AND
								 A2.CONTA_CONTABIL	= @CONTA_CONTABIL												AND
								(@TIPO_MOVIMENTO 	IS NULL     OR A1.TIPO_MOVIMENTO		= @TIPO_MOVIMENTO	)	AND
								(@FILTRA_COD_MATRIZ	IS NULL		OR D.COD_MATRIZ_CONTABIL	= @FILTRA_COD_MATRIZ)	AND
								(@FILTRA_COD_FILIAL	IS NULL		OR A.COD_FILIAL			=	  @FILTRA_COD_FILIAL)	
						GROUP BY A.EMPRESA, A2.CONTA_CONTABIL, B.DESC_CONTA, A.COD_FILIAL, D.FILIAL, A2.MOEDA, D.COD_MATRIZ_CONTABIL, B.ULTIMO_CHEQUE


						UPDATE B SET
							SALDO_ATUAL			= B.SALDO_ATUAL + ISNULL(A.SALDO_ATUAL,0),
							DATA_ULTIMO_LANCTO	= ISNULL(A.DATA_ULTIMO_LANCTO,B.DATA_ULTIMO_LANCTO)
						FROM #SALDO_ATUAL_CONTA_TEMP A
								JOIN #SALDO_ATUAL_CONTA B ON
									A.EMPRESA			= B.EMPRESA			AND
									A.CONTA_CONTABIL	= B.CONTA_CONTABIL	AND
									A.COD_FILIAL		= B.COD_FILIAL

						INSERT #SALDO_ATUAL_CONTA 
								(	EMPRESA, 
									CONTA_CONTABIL, 
									DESC_CONTA, 
									COD_FILIAL, 
									FILIAL, 
									MOEDA,
									SALDO_ATUAL, 
									DATA_ULTIMO_LANCTO, 
									SALDO_EM_CHEQUES,
									LIMITE_CONTA_CORRENTE,
									SALDO_BLOQ_CONTA_CORRENTE,
									PREVISAO_DESPESA,
									COD_MATRIZ_CONTABIL,
									NUMERO_CHEQUE
								) 					
						SELECT		A.EMPRESA, 
									A.CONTA_CONTABIL, 
									A.DESC_CONTA, 
									A.COD_FILIAL, 
									A.FILIAL, 
									A.MOEDA,
									A.SALDO_ATUAL, 
									A.DATA_ULTIMO_LANCTO, 
									A.SALDO_EM_CHEQUES,
									A.LIMITE_CONTA_CORRENTE,
									A.SALDO_BLOQ_CONTA_CORRENTE,
									A.PREVISAO_DESPESA,
									A.COD_MATRIZ_CONTABIL,
									A.NUMERO_CHEQUE
						FROM #SALDO_ATUAL_CONTA_TEMP A
								LEFT JOIN #SALDO_ATUAL_CONTA B ON
									A.EMPRESA			= B.EMPRESA			AND
									A.CONTA_CONTABIL	= B.CONTA_CONTABIL	AND
									A.COD_FILIAL		= B.COD_FILIAL
						WHERE B.EMPRESA IS NULL			
							
--						SELECT * FROM #SALDO_ATUAL_CONTA_TEMP	
--						SELECT * FROM #SALDO_ATUAL_CONTA

						-- ALEX - COMENTADO POIS ESTAVA GERANDO DUPLICIDADE E INCLUIDO ANTES DO INSERT
						--UPDATE B SET
						--	SALDO_ATUAL			= B.SALDO_ATUAL + ISNULL(A.SALDO_ATUAL,0),
						--	DATA_ULTIMO_LANCTO	= ISNULL(A.DATA_ULTIMO_LANCTO,B.DATA_ULTIMO_LANCTO)
						--FROM #SALDO_ATUAL_CONTA_TEMP A
						--		JOIN #SALDO_ATUAL_CONTA B ON
						--			A.EMPRESA			= B.EMPRESA			AND
						--			A.CONTA_CONTABIL	= B.CONTA_CONTABIL	AND
						--			A.COD_FILIAL		= B.COD_FILIAL

--						SELECT * FROM #SALDO_ATUAL_CONTA
														
						UPDATE D SET SALDO_EM_CHEQUES = A.SALDO_CHEQUES
						FROM #SALDO_ATUAL_CONTA D
								JOIN (		SELECT A.EMPRESA, A.CONTA_CONTABIL AS CONTA_CONTABIL, B.COD_FILIAL AS COD_FILIAL_RATEIO, CAST(SUM(CREDITO+DEBITO) AS DECIMAL(19,2)) AS SALDO_CHEQUES
													FROM CTB_CHEQUE A (NOLOCK)
															JOIN W_CTB_CHEQUE_SALDO A1 (NOLOCK) ON
																A.EMPRESA			= A1.EMPRESA			AND
																A.LANCAMENTO		= A1.LANCAMENTO			AND
																A.ITEM				= A1.ITEM	
															JOIN CTB_LANCAMENTO_RATEIO B (NOLOCK) ON
																A.EMPRESA				= B.EMPRESA 		AND
																A.LANCAMENTO 			= B.LANCAMENTO		AND
																A.ITEM					= B.ITEM
															JOIN CTB_LANCAMENTO B1 (NOLOCK) ON
																B.EMPRESA				= B1.EMPRESA		AND
																B.LANCAMENTO			= B1.LANCAMENTO
															JOIN #FILIAL_MATRIZ_CONTABIL_TEMP D1 ON
																B.COD_FILIAL	= D1.COD_FILIAL																			
															JOIN #USERS_MATRIZ_CONTABIL_TEMP C ON
																D1.COD_MATRIZ_CONTABIL			= C.COD_MATRIZ_CONTABIL
													WHERE	A1.VALOR_A_PAGAR > 0 								AND
															DBO.LX_DATA_REAL(NULL,A.VENCIMENTO) 		<= @DATA_FINAL		AND
															(@EMPRESA 				IS NULL     OR A.EMPRESA				= @EMPRESA 			)	AND
															A.CONTA_CONTABIL		= @CONTA_CONTABIL												AND
															(@TIPO_MOVIMENTO 		IS NULL     OR B1.TIPO_MOVIMENTO			= @TIPO_MOVIMENTO	)	AND									
															(@FILTRA_COD_MATRIZ		IS NULL		OR D1.COD_MATRIZ_CONTABIL	= @FILTRA_COD_MATRIZ)	AND
															(@FILTRA_COD_FILIAL		IS NULL		OR B.COD_FILIAL			=	  @FILTRA_COD_FILIAL)	
										GROUP BY A.EMPRESA, A.CONTA_CONTABIL, B.COD_FILIAL	
										) A ON 
									A.EMPRESA				= D.EMPRESA				AND
									A.CONTA_CONTABIL		= D.CONTA_CONTABIL	AND
									A.COD_FILIAL_RATEIO		= D.COD_FILIAL
						WHERE a.CONTA_CONTABIL = 	@CONTA_CONTABIL	
						
			END
			
		SELECT A.*, MATRIZ_CONTABIL = B.NOME_CLIFOR, 
					SALDO_S_CHEQUES = CAST(SALDO_ATUAL-SALDO_EM_CHEQUES  AS DECIMAL(19,2))
		FROM #SALDO_ATUAL_CONTA A 
				JOIN W_CTB_MATRIZ_CONTABIL B ON
					A.COD_MATRIZ_CONTABIL = B.COD_CLIFOR
		ORDER BY A.EMPRESA, A.CONTA_CONTABIL, A.COD_FILIAL


		RETURN		
	
	END
	

IF @TIPO = 'M'
	BEGIN

		CREATE TABLE #MOV_CONTA_CORRENTE
				( 	EMPRESA					INT,
					LANCAMENTO				INT,
					ITEM						INT,
					CONTA_CONTABIL			VARCHAR(20)  	COLLATE DATABASE_DEFAULT,
					COD_FILIAL				VARCHAR(6)		COLLATE DATABASE_DEFAULT,
					SALDO_ANTERIOR			DECIMAL(19,2),
					VALOR						DECIMAL(19,2),
					SALDO_ATUAL				DECIMAL(19,2),
					DATA_LANCAMENTO		DATETIME,
					TIPO_MOVIMENTO			INT,
					HISTORICO				VARCHAR(250)  	COLLATE DATABASE_DEFAULT,
					LX_TIPO_LANCAMENTO	VARCHAR(3)  	COLLATE DATABASE_DEFAULT,
					DESC_TIPO_LANCAMENTO	VARCHAR(40)  	COLLATE DATABASE_DEFAULT,
					COD_MATRIZ_CONTABIL	VARCHAR(6)		COLLATE DATABASE_DEFAULT, 
					NUMERO_CHEQUE		VARCHAR(10)	
				)

		INSERT #MOV_CONTA_CORRENTE 
				( 	EMPRESA,
					LANCAMENTO,
					ITEM,
					CONTA_CONTABIL,
					COD_FILIAL,
					SALDO_ANTERIOR,
					VALOR,
					SALDO_ATUAL,
					DATA_LANCAMENTO,
					TIPO_MOVIMENTO,
					HISTORICO,
					LX_TIPO_LANCAMENTO,
					DESC_TIPO_LANCAMENTO,
					COD_MATRIZ_CONTABIL,
					NUMERO_CHEQUE	
				)
		SELECT 	A.EMPRESA, 
					A.LANCAMENTO,
					A.ITEM,
					A2.CONTA_CONTABIL,
					A.COD_FILIAL,
					0.00,
					VALOR			= CASE WHEN A.DEBITO > 0 THEN A.DEBITO ELSE A.CREDITO*-1 END, 
					0.00,
					A1.DATA_LANCAMENTO,
					A1.TIPO_MOVIMENTO,
					A2.HISTORICO,
					A2.LX_TIPO_LANCAMENTO,
					F.DESC_TIPO_LANCAMENTO,
					D.COD_MATRIZ_CONTABIL,
					B.ULTIMO_CHEQUE
		FROM CTB_LANCAMENTO_RATEIO A (NOLOCK)
				JOIN CTB_LANCAMENTO A1 (NOLOCK) ON
					A.EMPRESA		= A1.EMPRESA			AND
					A.LANCAMENTO	= A1.LANCAMENTO
				JOIN CTB_LANCAMENTO_ITEM A2 (NOLOCK) ON
					A.EMPRESA		= A2.EMPRESA			AND
					A.LANCAMENTO	= A2.LANCAMENTO			AND
					A.ITEM			= A2.ITEM	
				JOIN CTB_CONTA_PLANO B (NOLOCK) ON
					A2.CONTA_CONTABIL = B.CONTA_CONTABIL 
				JOIN #FILIAL_MATRIZ_CONTABIL_TEMP D ON
					A.COD_FILIAL	= D.COD_FILIAL
				JOIN #USERS_MATRIZ_CONTABIL_TEMP E ON
					D.COD_MATRIZ_CONTABIL			= E.COD_MATRIZ_CONTABIL
				JOIN CTB_LX_LANCAMENTO_TIPO	F (NOLOCK) ON
					A2.LX_TIPO_LANCAMENTO = F.LX_TIPO_LANCAMENTO
		WHERE	A1.DATA_LANCAMENTO 	>= @DATA_INICIAL		AND
				A1.DATA_LANCAMENTO 	<= @DATA_FINAL			AND
				(@EMPRESA 			IS NULL     OR A.EMPRESA				= @EMPRESA 			)	AND
				((A2.CONTA_CONTABIL		= @CONTA_CONTABIL	) OR CHARINDEX('['+RTRIM(A2.CONTA_CONTABIL)+']',@FILTRA_CONTA) > 0) AND
				(@TIPO_MOVIMENTO 	IS NULL     OR A1.TIPO_MOVIMENTO		= @TIPO_MOVIMENTO	)	AND				
				(@FILTRA_COD_MATRIZ	IS NULL		OR D.COD_MATRIZ_CONTABIL	= @FILTRA_COD_MATRIZ)	AND
				(@FILTRA_COD_FILIAL	IS NULL		OR A.COD_FILIAL			=	  @FILTRA_COD_FILIAL)	
		ORDER BY A.EMPRESA, A2.CONTA_CONTABIL, A.COD_FILIAL, A1.DATA_LANCAMENTO, A.LANCAMENTO, A.ITEM, D.COD_MATRIZ_CONTABIL, B.ULTIMO_CHEQUE


		CREATE  INDEX #XIE1MOV_CONTA_CORRENTE ON #MOV_CONTA_CORRENTE(EMPRESA, LANCAMENTO, ITEM, CONTA_CONTABIL, COD_FILIAL, DATA_LANCAMENTO) WITH  FILLFACTOR = 10 ON [PRIMARY]
		

		DECLARE CUR_CONTA_CORRENTE CURSOR LOCAL FAST_FORWARD READ_ONLY FOR 
		SELECT EMPRESA, LANCAMENTO, ITEM, DATA_LANCAMENTO, CONTA_CONTABIL, COD_FILIAL, VALOR, TIPO_MOVIMENTO
		FROM #MOV_CONTA_CORRENTE
		ORDER BY EMPRESA, CONTA_CONTABIL, COD_FILIAL, DATA_LANCAMENTO, LANCAMENTO, ITEM
		
		OPEN CUR_CONTA_CORRENTE
		
		FETCH NEXT FROM CUR_CONTA_CORRENTE
		INTO @EMPRESA_CUR, @LANCAMENTO_CUR, @ITEM_CUR, @DATA_LANCAMENTO_CUR, @CONTA_CONTABIL_CUR, @COD_FILIAL_CUR, @VALOR_CUR, @TIPO_MOVIMENTO_CUR
		
		SELECT @WHILE = ''	

		WHILE @@FETCH_STATUS = 0
			BEGIN
		
				IF @WHILE <> RTRIM(CAST(@EMPRESA_CUR AS VARCHAR(10)))+'-'+RTRIM(CAST(@CONTA_CONTABIL_CUR AS VARCHAR(30)))+'-'+RTRIM(CAST(@COD_FILIAL_CUR AS VARCHAR(6)))
					BEGIN
						SELECT @SALDO_ANTERIOR = 0.00

						SELECT @SALDO_ANTERIOR = ISNULL(SUM(A.DEBITO) - SUM(A.CREDITO),0.00)
						FROM CTB_LANCAMENTO_RATEIO A (NOLOCK)
								JOIN CTB_LANCAMENTO A1 (NOLOCK) ON
									A.EMPRESA		= A1.EMPRESA			AND
									A.LANCAMENTO	= A1.LANCAMENTO
								JOIN CTB_LANCAMENTO_ITEM A2 (NOLOCK) ON
									A.EMPRESA		= A2.EMPRESA			AND
									A.LANCAMENTO	= A2.LANCAMENTO			AND
									A.ITEM			= A2.ITEM							
								JOIN #FILIAL_MATRIZ_CONTABIL_TEMP D ON
									A.COD_FILIAL	= D.COD_FILIAL
								JOIN #USERS_MATRIZ_CONTABIL_TEMP E ON
									D.COD_MATRIZ_CONTABIL			= E.COD_MATRIZ_CONTABIL
						WHERE	A1.DATA_LANCAMENTO 			< @DATA_INICIAL				AND
								A.EMPRESA					= @EMPRESA_CUR				AND
								A2.CONTA_CONTABIL			= @CONTA_CONTABIL_CUR		AND
								A.COD_FILIAL				= @COD_FILIAL_CUR			AND
				            (@EMPRESA 			IS NULL     OR A.EMPRESA				= @EMPRESA 			)			AND
              				((A2.CONTA_CONTABIL		= @CONTA_CONTABIL	) OR CHARINDEX('['+RTRIM(A2.CONTA_CONTABIL)+']',@FILTRA_CONTA) > 0) AND
				            (@TIPO_MOVIMENTO 	IS NULL     OR A1.TIPO_MOVIMENTO		= @TIPO_MOVIMENTO	)			AND
            				(@FILTRA_COD_MATRIZ	IS NULL		OR D.COD_MATRIZ_CONTABIL	= @FILTRA_COD_MATRIZ)	AND
							(@FILTRA_COD_FILIAL	IS NULL		OR A.COD_FILIAL				= @FILTRA_COD_FILIAL)	

                  SELECT @SALDO_ANTERIOR = ISNULL(@SALDO_ANTERIOR,0.00) + CASE WHEN ISNULL(@USAR_LIMITE,0) = 1 THEN MAX(ISNULL(LIMITE_CONTA_CORRENTE,0.00)) ELSE 0.00 END
                  FROM CTB_CONTA_PLANO
                  WHERE CONTA_CONTABIL = @CONTA_CONTABIL_CUR

						UPDATE #MOV_CONTA_CORRENTE SET 
								SALDO_ANTERIOR = @SALDO_ANTERIOR,
								SALDO_ATUAL		= @SALDO_ANTERIOR+@VALOR_CUR
						FROM #MOV_CONTA_CORRENTE
						WHERE	EMPRESA				= @EMPRESA_CUR				AND
								LANCAMENTO			= @LANCAMENTO_CUR			AND
								ITEM				= @ITEM_CUR					AND
								CONTA_CONTABIL		= @CONTA_CONTABIL_CUR	AND
								COD_FILIAL			= @COD_FILIAL_CUR			AND
								DATA_LANCAMENTO		= @DATA_LANCAMENTO_CUR

						SELECT @WHILE = RTRIM(CAST(@EMPRESA_CUR AS VARCHAR(10)))+'-'+RTRIM(CAST(@CONTA_CONTABIL_CUR AS VARCHAR(30)))+'-'+RTRIM(CAST(@COD_FILIAL_CUR AS VARCHAR(6)))
						SELECT @COUNT = 1

					END
		
				IF @COUNT > 1
					BEGIN
						UPDATE #MOV_CONTA_CORRENTE SET 
								SALDO_ANTERIOR = @SALDO_ANTERIOR,
								SALDO_ATUAL		= @SALDO_ANTERIOR+@VALOR_CUR
						FROM #MOV_CONTA_CORRENTE
						WHERE EMPRESA				= @EMPRESA_CUR				AND
								LANCAMENTO			= @LANCAMENTO_CUR			AND
								ITEM				= @ITEM_CUR					AND
								CONTA_CONTABIL		= @CONTA_CONTABIL_CUR		AND
								COD_FILIAL			= @COD_FILIAL_CUR			AND
								DATA_LANCAMENTO		= @DATA_LANCAMENTO_CUR
					END

				SELECT @SALDO_ANTERIOR = @SALDO_ANTERIOR+@VALOR_CUR

				SELECT @COUNT = @COUNT + 1

				FETCH NEXT FROM CUR_CONTA_CORRENTE
				INTO @EMPRESA_CUR, @LANCAMENTO_CUR, @ITEM_CUR, @DATA_LANCAMENTO_CUR, @CONTA_CONTABIL_CUR, @COD_FILIAL_CUR, @VALOR_CUR, @TIPO_MOVIMENTO_CUR
		
			END
		
		CLOSE CUR_CONTA_CORRENTE
		DEALLOCATE CUR_CONTA_CORRENTE
	
		SELECT A.*, B.DESC_CONTA, B.BANCO, B.AGENCIA, B.CONTA_CORRENTE, B.NUMERO_CONTA_CORRENTE, C.FILIAL, D.DESC_TIPO_MOVIMENTO, MATRIZ_CONTABIL = E.NOME_CLIFOR 
			FROM #MOV_CONTA_CORRENTE A
						JOIN CTB_CONTA_PLANO B (NOLOCK) ON
							A.CONTA_CONTABIL 	= B.CONTA_CONTABIL
						JOIN FILIAIS C (NOLOCK) ON	
							A.COD_FILIAL		= C.COD_FILIAL	
						JOIN CTB_MOVIMENTO_TIPO D (NOLOCK) ON
							A.TIPO_MOVIMENTO	= D.TIPO_MOVIMENTO
						JOIN W_CTB_MATRIZ_CONTABIL E ON
							A.COD_MATRIZ_CONTABIL = E.COD_CLIFOR
		ORDER BY A.EMPRESA, A.CONTA_CONTABIL, A.COD_FILIAL, A.DATA_LANCAMENTO, A.LANCAMENTO, A.ITEM
	END


IF @TIPO = 'N'
	BEGIN

		CREATE TABLE #MOV_CONTA_CORRENTE_RESUMO
				( 	EMPRESA					INT,
					LANCAMENTO				INT,
					ITEM					INT,
					CONTA_CONTABIL			VARCHAR(20)  	COLLATE DATABASE_DEFAULT,
					MOEDA					CHAR(6),
					SALDO_ANTERIOR			DECIMAL(19,2),
					VALOR					DECIMAL(19,2),
					VALOR_MOEDA				DECIMAL(19,2),
					SALDO_ATUAL				DECIMAL(19,2),
					DATA_LANCAMENTO			DATETIME,
					HISTORICO				VARCHAR(250)  	COLLATE DATABASE_DEFAULT,
					LX_TIPO_LANCAMENTO		VARCHAR(3)  	COLLATE DATABASE_DEFAULT,
					DESC_TIPO_LANCAMENTO	VARCHAR(40)  	COLLATE DATABASE_DEFAULT,
					TIPO_MOVIMENTO			INT,
					DESC_TIPO_MOVIMENTO		VARCHAR(40)  	COLLATE DATABASE_DEFAULT,
					COD_MATRIZ_CONTABIL		VARCHAR(6)		COLLATE DATABASE_DEFAULT, 
					NUMERO_CHEQUE			VARCHAR(6)
				)

		INSERT #MOV_CONTA_CORRENTE_RESUMO 
				( 	EMPRESA,
					LANCAMENTO,
					ITEM,
					CONTA_CONTABIL,
					MOEDA,
					SALDO_ANTERIOR,
					VALOR,
					VALOR_MOEDA,
					SALDO_ATUAL,
					DATA_LANCAMENTO,
					HISTORICO,
					LX_TIPO_LANCAMENTO,
					DESC_TIPO_LANCAMENTO,
					TIPO_MOVIMENTO,
					DESC_TIPO_MOVIMENTO,
					COD_MATRIZ_CONTABIL,
					NUMERO_CHEQUE
				)
		SELECT 	A.EMPRESA, 
					A.LANCAMENTO,
					A.ITEM,
					A.CONTA_CONTABIL, 
					A.MOEDA,
					0.00,
					VALOR			= CASE WHEN A.DEBITO > 0 THEN A.DEBITO ELSE A.CREDITO*-1 END, 
					VALOR_MOEDA		= CASE WHEN A.DEBITO_MOEDA > 0 THEN A.DEBITO_MOEDA ELSE A.CREDITO_MOEDA*-1 END, 
					0.00,
					A1.DATA_LANCAMENTO,
					A.HISTORICO,
					A.LX_TIPO_LANCAMENTO,
					F.DESC_TIPO_LANCAMENTO,
					A1.TIPO_MOVIMENTO,
					G.DESC_TIPO_MOVIMENTO,
					C.COD_MATRIZ_CONTABIL,
					B.ULTIMO_CHEQUE
		FROM CTB_LANCAMENTO_ITEM A (NOLOCK)
				JOIN CTB_LANCAMENTO A1 (NOLOCK) ON
					A.EMPRESA		= A1.EMPRESA		AND
					A.LANCAMENTO	= A1.LANCAMENTO
				JOIN CTB_CONTA_PLANO B (NOLOCK) ON
					A.CONTA_CONTABIL = B.CONTA_CONTABIL 
				JOIN #RATEIO_FILIAL_MATRIZ_CONTABIL_TEMP C ON
					A.RATEIO_FILIAL	= C.RATEIO_FILIAL
				JOIN #USERS_MATRIZ_CONTABIL_TEMP E ON
					C.COD_MATRIZ_CONTABIL			= E.COD_MATRIZ_CONTABIL
				JOIN CTB_LX_LANCAMENTO_TIPO F (NOLOCK) ON
					A.LX_TIPO_LANCAMENTO = F.LX_TIPO_LANCAMENTO
				JOIN CTB_MOVIMENTO_TIPO	G (NOLOCK) ON
					A1.TIPO_MOVIMENTO = G.TIPO_MOVIMENTO	
		WHERE	A1.DATA_LANCAMENTO 	>= @DATA_INICIAL		AND
				A1.DATA_LANCAMENTO 	<= @DATA_FINAL			AND
				(@EMPRESA 			IS NULL     OR A.EMPRESA				= @EMPRESA 			)	AND
				((A.CONTA_CONTABIL		= @CONTA_CONTABIL	) OR CHARINDEX('['+RTRIM(A.CONTA_CONTABIL)+']',@FILTRA_CONTA) > 0) AND
				(@TIPO_MOVIMENTO 	IS NULL     OR A1.TIPO_MOVIMENTO		= @TIPO_MOVIMENTO	)	AND
				(@FILTRA_COD_MATRIZ	IS NULL		OR C.COD_MATRIZ_CONTABIL	= @FILTRA_COD_MATRIZ) AND
				(@FILTRA_COD_FILIAL	IS NULL		OR A1.COD_FILIAL			=	  @FILTRA_COD_FILIAL)	

		ORDER BY A.EMPRESA, A.CONTA_CONTABIL, A1.DATA_LANCAMENTO, A.LANCAMENTO, A.ITEM


		DECLARE CUR_CONTA_CORRENTE CURSOR LOCAL FAST_FORWARD READ_ONLY FOR 
		SELECT EMPRESA, LANCAMENTO, ITEM, DATA_LANCAMENTO, CONTA_CONTABIL, MOEDA, VALOR, VALOR_MOEDA
		FROM #MOV_CONTA_CORRENTE_RESUMO
		ORDER BY EMPRESA, CONTA_CONTABIL, DATA_LANCAMENTO, LANCAMENTO, ITEM
		
		OPEN CUR_CONTA_CORRENTE
		
		FETCH NEXT FROM CUR_CONTA_CORRENTE
		INTO @EMPRESA_CUR, @LANCAMENTO_CUR, @ITEM_CUR, @DATA_LANCAMENTO_CUR, @CONTA_CONTABIL_CUR, @MOEDA_CUR, @VALOR_CUR, @VALOR_MOEDA_CUR
		
		SELECT @WHILE = ''	

		WHILE @@FETCH_STATUS = 0
			BEGIN
		
				IF @WHILE <> RTRIM(CAST(@EMPRESA_CUR AS VARCHAR(10)))+'-'+RTRIM(CAST(@CONTA_CONTABIL_CUR AS VARCHAR(30)))
					BEGIN
						SELECT @SALDO_ANTERIOR = 0.00

						SELECT @SALDO_ANTERIOR = ISNULL(SUM(A.DEBITO)-SUM(A.CREDITO),0.00)
						FROM CTB_LANCAMENTO_ITEM A (NOLOCK)
								JOIN CTB_LANCAMENTO A1 (NOLOCK) ON
									A.EMPRESA		= A1.EMPRESA		AND
									A.LANCAMENTO	= A1.LANCAMENTO
								JOIN CTB_CONTA_PLANO B (NOLOCK) ON
									A.CONTA_CONTABIL = B.CONTA_CONTABIL 
								LEFT JOIN #RATEIO_FILIAL_MATRIZ_CONTABIL_TEMP C ON
									A.RATEIO_FILIAL	= C.RATEIO_FILIAL
								JOIN #USERS_MATRIZ_CONTABIL_TEMP D ON
									C.COD_MATRIZ_CONTABIL			= D.COD_MATRIZ_CONTABIL
						WHERE A1.DATA_LANCAMENTO 		< @DATA_INICIAL			AND
								A.EMPRESA					= @EMPRESA_CUR				AND
								A.CONTA_CONTABIL			= @CONTA_CONTABIL_CUR	AND
				            (@EMPRESA 			IS NULL     OR A.EMPRESA				= @EMPRESA 			)	AND
				            ((A.CONTA_CONTABIL		= @CONTA_CONTABIL	) OR CHARINDEX('['+RTRIM(A.CONTA_CONTABIL)+']',@FILTRA_CONTA) > 0) AND
				            (@TIPO_MOVIMENTO 	IS NULL     OR A1.TIPO_MOVIMENTO		= @TIPO_MOVIMENTO	)	AND
				            (@FILTRA_COD_MATRIZ	IS NULL		OR C.COD_MATRIZ_CONTABIL	= @FILTRA_COD_MATRIZ)	AND
							(@FILTRA_COD_FILIAL	IS NULL		OR A1.COD_FILIAL			= @FILTRA_COD_FILIAL)	

                  SELECT @SALDO_ANTERIOR = ISNULL(@SALDO_ANTERIOR,0.00) + CASE WHEN ISNULL(@USAR_LIMITE,0) = 1 THEN MAX(ISNULL(LIMITE_CONTA_CORRENTE,0.00)) ELSE 0.00 END
                  FROM CTB_CONTA_PLANO
                  WHERE CONTA_CONTABIL = @CONTA_CONTABIL_CUR

						UPDATE #MOV_CONTA_CORRENTE_RESUMO SET 
								SALDO_ANTERIOR = @SALDO_ANTERIOR,
								SALDO_ATUAL		= @SALDO_ANTERIOR+@VALOR_CUR
						FROM #MOV_CONTA_CORRENTE_RESUMO
						WHERE EMPRESA				= @EMPRESA_CUR				AND
								LANCAMENTO			= @LANCAMENTO_CUR			AND
								ITEM					= @ITEM_CUR					AND
								CONTA_CONTABIL		= @CONTA_CONTABIL_CUR	AND
								DATA_LANCAMENTO	= @DATA_LANCAMENTO_CUR	

						SELECT @WHILE = RTRIM(CAST(@EMPRESA_CUR AS VARCHAR(10)))+'-'+RTRIM(CAST(@CONTA_CONTABIL_CUR AS VARCHAR(30)))
						SELECT @COUNT = 1

					END
		
				IF @COUNT > 1
					BEGIN
						UPDATE #MOV_CONTA_CORRENTE_RESUMO SET 
								SALDO_ANTERIOR = @SALDO_ANTERIOR,
								SALDO_ATUAL		= @SALDO_ANTERIOR+@VALOR_CUR
						FROM #MOV_CONTA_CORRENTE_RESUMO
						WHERE EMPRESA				= @EMPRESA_CUR				AND
								LANCAMENTO			= @LANCAMENTO_CUR			AND
								ITEM					= @ITEM_CUR					AND
								CONTA_CONTABIL		= @CONTA_CONTABIL_CUR	AND
								DATA_LANCAMENTO	= @DATA_LANCAMENTO_CUR
					END

				SELECT @SALDO_ANTERIOR = @SALDO_ANTERIOR+@VALOR_CUR

				SELECT @COUNT = @COUNT + 1

				FETCH NEXT FROM CUR_CONTA_CORRENTE
				INTO @EMPRESA_CUR, @LANCAMENTO_CUR, @ITEM_CUR, @DATA_LANCAMENTO_CUR, @CONTA_CONTABIL_CUR, @MOEDA_CUR, @VALOR_CUR, @VALOR_MOEDA_CUR
		
			END
		
		CLOSE CUR_CONTA_CORRENTE
		DEALLOCATE CUR_CONTA_CORRENTE
	
		SELECT A.*, B.DESC_CONTA, B.BANCO, B.AGENCIA, B.CONTA_CORRENTE, B.NUMERO_CONTA_CORRENTE, A.COD_MATRIZ_CONTABIL, MATRIZ_CONTABIL = C.NOME_CLIFOR
			FROM #MOV_CONTA_CORRENTE_RESUMO A
						JOIN CTB_CONTA_PLANO B ON
							A.CONTA_CONTABIL 	= B.CONTA_CONTABIL
						JOIN W_CTB_MATRIZ_CONTABIL C ON
							A.COD_MATRIZ_CONTABIL = C.COD_CLIFOR
		ORDER BY A.EMPRESA, A.CONTA_CONTABIL, A.DATA_LANCAMENTO, A.LANCAMENTO, A.ITEM
	END

SET NOCOUNT OFF
SET TRANSACTION ISOLATION LEVEL READ COMMITTED

IF	(	SELECT	OBJECT_ID('TEMPDB..#CONTA_CONTABIL')	)	IS NOT NULL
	DROP TABLE	#CONTA_CONTABIL

IF	(	SELECT	OBJECT_ID('TEMPDB..#FILIAL_MATRIZ_CONTABIL_TEMP')	)	IS NOT NULL
	DROP TABLE	#FILIAL_MATRIZ_CONTABIL_TEMP

IF	(	SELECT	OBJECT_ID('TEMPDB..#RATEIO_FILIAL_MATRIZ_CONTABIL_TEMP')	)	IS NOT NULL
	DROP TABLE	#RATEIO_FILIAL_MATRIZ_CONTABIL_TEMP

IF	(	SELECT	OBJECT_ID('TEMPDB..#USERS_MATRIZ_CONTABIL_TEMP')	)	IS NOT NULL
	DROP TABLE	#USERS_MATRIZ_CONTABIL_TEMP

IF	(	SELECT	OBJECT_ID('TEMPDB..#SALDO_ATUAL_CONTA')	)	IS NOT NULL
	DROP TABLE	#SALDO_ATUAL_CONTA

IF	(	SELECT	OBJECT_ID('TEMPDB..#SALDO_ATUAL_CONTA_TEMP')	)	IS NOT NULL
	DROP TABLE	#SALDO_ATUAL_CONTA_TEMP

IF	(	SELECT	OBJECT_ID('TEMPDB..#MOV_CONTA_CORRENTE')	)	IS NOT NULL
	DROP TABLE	#MOV_CONTA_CORRENTE

IF	(	SELECT	OBJECT_ID('TEMPDB..#MOV_CONTA_CORRENTE_RESUMO')	)	IS NOT NULL
	DROP TABLE	#MOV_CONTA_CORRENTE_RESUMO

RETURN

ERROR:
	SET NOCOUNT OFF
	SET TRANSACTION ISOLATION LEVEL READ COMMITTED

	IF	(	SELECT	OBJECT_ID('TEMPDB..#CONTA_CONTABIL')	)	IS NOT NULL
		DROP TABLE	#CONTA_CONTABIL

	IF	(	SELECT	OBJECT_ID('TEMPDB..#FILIAL_MATRIZ_CONTABIL_TEMP')	)	IS NOT NULL
		DROP TABLE	#FILIAL_MATRIZ_CONTABIL_TEMP

	IF	(	SELECT	OBJECT_ID('TEMPDB..#RATEIO_FILIAL_MATRIZ_CONTABIL_TEMP')	)	IS NOT NULL
		DROP TABLE	#RATEIO_FILIAL_MATRIZ_CONTABIL_TEMP

	IF	(	SELECT	OBJECT_ID('TEMPDB..#USERS_MATRIZ_CONTABIL_TEMP')	)	IS NOT NULL
		DROP TABLE	#USERS_MATRIZ_CONTABIL_TEMP

	IF	(	SELECT	OBJECT_ID('TEMPDB..#SALDO_ATUAL_CONTA')	)	IS NOT NULL
		DROP TABLE	#SALDO_ATUAL_CONTA
		
	IF	(	SELECT	OBJECT_ID('TEMPDB..#SALDO_ATUAL_CONTA_TEMP')	)	IS NOT NULL
		DROP TABLE	#SALDO_ATUAL_CONTA_TEMP

	IF	(	SELECT	OBJECT_ID('TEMPDB..#MOV_CONTA_CORRENTE')	)	IS NOT NULL
		DROP TABLE	#MOV_CONTA_CORRENTE

	IF	(	SELECT	OBJECT_ID('TEMPDB..#MOV_CONTA_CORRENTE_RESUMO')	)	IS NOT NULL
		DROP TABLE	#MOV_CONTA_CORRENTE_RESUMO
	
	IF (CURSOR_STATUS('LOCAL','CUR_CONTA_CORRENTE'  )>-3 )
		BEGIN
			CLOSE 		CUR_CONTA_CORRENTE
			DEALLOCATE 	CUR_CONTA_CORRENTE
		END
		
	IF @ERRMSG IS NOT NULL
		raiserror (@errmsg, 16, 1)


