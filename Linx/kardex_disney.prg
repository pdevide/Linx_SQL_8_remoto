FUNCTION CriarPasta
PARAMETERS tcPasta
LOCAL ofs as Object
ofs = CreateObject("Scripting.FileSystemObject")
IF NOT ofs.FolderExists(tcPasta)
	ofs.CreateFolder(tcPasta)
ENDIF
RELEASE ofs
RETURN .t.

PROCEDURE BuscaKardex
PARAMETERS  tcProduto, tcCor, tcFilial
TEXT TO  lcSQL NOSHOW TEXTMERGE
SELECT TIPOMOVTO,
       DOC,
       FX_MONTA_CARDEX_PA.PRODUTO,
       FX_MONTA_CARDEX_PA.COR_PRODUTO,
       PRODUTO_CORES.DESC_COR_PRODUTO,
       FILIAL,
       CONVERT(VARCHAR,EMISSAO,103) as EMISSAO,
       OP_PED_ROMAN,
       TT_MOV,
       EN_1,
       EN_2,
       EN_3,
       EN_4,
       EN_5,
       EN_6,
       EN_7,
       EN_8,
       EN_9,
       EN_10,
       EN_11,
       EN_12,
       EN_13,
       EN_14,
       EN_15,
       EN_16,
       TT_SALDO,
       SALDO1,
       SALDO2,
       SALDO3,
       SALDO4,
       SALDO5,
       SALDO6,
       SALDO7,
       SALDO8,
       SALDO9,
       SALDO10,
       SALDO11,
       SALDO12,
       SALDO13,
       SALDO14,
       SALDO15,
       SALDO16,
       PRECO,
       VALOR,
       FRETE_SEGURO_ENCARGO,
       DESCONTO,
       ICMS_VALOR,
       IPI_VALOR,
       COFINS_VALOR,
       PIS_VALOR,
       DESP_IMPORT,
       CONTA_CONTABIL_COMPRA,
       CONTA_CONTABIL,
       CONTA_CONTABIL_MOVIMENTO,
       RATEIO_CENTRO_CUSTO,
       RATEIO_FILIAL,
       NATUREZA,
       DESC_NATUREZA,
       CTB_TIPO_OPERACAO,
       DESC_TIPO_OPERACAO,
       TIPO_OPERACAO,
       DESC_GRUPO_TIPO_OPERACAO
FROM       DBO.FX_MONTA_CARDEX_PA('<<tcProduto>>', '<<tcCor>>', '<<tcFilial>>', 0)
JOIN PRODUTO_CORES ON PRODUTO_CORES.PRODUTO = FX_MONTA_CARDEX_PA.PRODUTO
AND PRODUTO_CORES.COR_PRODUTO = FX_MONTA_CARDEX_PA.COR_PRODUTO
ORDER BY EMISSAO,
         TIPOMOVTO,
         DOC,
         FILIAL,
         PRODUTO,
         COR_PRODUTO,
         OP_PED_ROMAN
ENDTEXT
IF USED("vKardex01")
	USE IN vKardex01
ENDIF
f_select(lcSQL, "vKardex01")

RETURN

ENDPROC

PROCEDURE abre_txt
LPARAMETERS _lcProduto
STRTOFILE(CabecTabela(),_lcProduto)
ENDPROC

PROCEDURE fecha_txt
MESSAGEBOX("Processo gerado com sucesso!",64,"Aviso")
ENDPROC

FUNCTION CabecTabela
sCabec = "TIPOMOVTO;DOC;PRODUTO;COR_PRODUTO;DESC_COR_PRODUTO;FILIAL;EMISSAO;OP_PED_ROMAN;TT_MOV;EN_1;EN_2;EN_3;EN_4;EN_5;EN_6;EN_7;EN_8;EN_9;EN_10;EN_11;EN_12;EN_13;EN_14;EN_15;EN_16;"
sCabec = sCabec + "TT_SALDO;SALDO1;SALDO2;SALDO3;SALDO4;SALDO5;SALDO6;SALDO7;SALDO8;SALDO9;SALDO10;SALDO11;SALDO12;SALDO13;SALDO14;SALDO15;SALDO16;"
sCabec = sCabec + "PRECO;VALOR;FRETE_SEGURO_ENCARGO;DESCONTO;ICMS_VALOR;IPI_VALOR;COFINS_VALOR;PIS_VALOR;DESP_IMPORT;CONTA_CONTABIL_COMPRA;CONTA_CONTABIL;"
sCabec = sCabec + "CONTA_CONTABIL_MOVIMENTO;RATEIO_CENTRO_CUSTO;RATEIO_FILIAL;NATUREZA;DESC_NATUREZA;CTB_TIPO_OPERACAO;DESC_TIPO_OPERACAO;TIPO_OPERACAO;DESC_GRUPO_TIPO_OPERACAO"
RETURN sCabec + cLineFeed
ENDFUNC

FUNCTION montalinha
linha = ""
separador = ";"
SELECT vkardex01
=AFIELDS(laCampos,"vkardex01")
FOR ixx=1 TO ALEN(laCampos,1)
	IF ixx = ALEN(laCampos,1)
		separador = ""
	ENDIF
	campo = laCampos(ixx,1)
	linha = linha + TRANSFORM(NVL(EVALUATE(campo),""))+separador
ENDFOR
RETURN linha + cLineFeed
ENDFUNC
