F_SELECT(CMDSQL,"V_BARRA")

CREATE CURSOR V_SKU (CODIGO_BARRA C(25), PRODUTO C(8), COR C(5), TAMANHO INT, QTDE INT) 
SELECT V_ESTOQUE
SCAN 
	FOR i=1 TO 16
		SELECT V_ESTOQUE
		xcoluna = "V_ESTOQUE.ES"+ALLTRIM(STR(i,2))
		IF NVL(&xcoluna.,0) <> 0
			SELECT V_BARRA
			LOCATE FOR PRODUTO = V_ESTOQUE.PRODUTO ;
				AND COR_PRODUTO = V_ESTOQUE.COR_PRODUTO AND TAMANHO = i
			IF FOUND()	
				INSERT INTO V_SKU (CODIGO_BARRA, PRODUTO, COR, TAMANHO, QTDE) ;
				VALUES (V_BARRA.CODIGO_BARRA, V_BARRA.PRODUTO, V_BARRA.COR_PRODUTO, V_BARRA.TAMANHO, NVL(&xcoluna.,0))
			ENDIF
		ENDIF
	ENDFOR
	SELECT V_ESTOQUE
	
ENDSCAN

SELECT V_SKU
COPY TO C:\TEMP\V_SKU.TXT DELIMITED WITH CHARACTER ";"

WAIT WINDOW "FIM"